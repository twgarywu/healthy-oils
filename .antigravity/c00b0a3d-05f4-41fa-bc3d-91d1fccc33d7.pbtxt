50\246\213\347\206\261\351\215\213\347\203\271\350\252\277\357\274\214\351\215\213\345\205\247\346\272\253\345\272\246\345\244\232\350\220\275\345\234\250 160-180\342\204\203\343\200\202\346\262\271\345\223\201\347\231\274\347\205\231\351\273\236\350\207\263\345\260\221\351\234\200\351\253\230\346\226\274 190\342\204\203 \346\226\271\350\203\275\347\242\272\344\277\235\345\256\211\345\205\250\347\204\241\350\207\264\347\231\214\346\262\271\347\205\231\343\200\202\',\n    exampleDishes: \'\345\256\266\345\270\270\350\202\211\347\265\262\347\202\222\350\217\234\343\200\201\351\246\231\347\205\216\350\261\206\350\205\220\343\200\201\350\215\267\345\214\205\350\233\213\343\200\201\350\222\234\350\223\211\347\202\222\350\235\246\',\n    recommendedOilIds: [\'camellia-oil\', \'avocado-oil\', \'canola-oil\', \'peanut-oil\', \'ghee\']\n  },\n  {\n    id: \'high_fry\',\n    label: \'\351\253\230\346\272\253\345\244\247\347\201\253\347\210\206\347\202\222 / \346\262\271\347\202\270\347\203\230\347\203\244\',\n    nameZh: \'\345\244\247\347\201\253\351\253\230\346\272\253\347\205\216\347\202\270\',\n    tempRange: \'190\342\204\203 ~ 230\342\204\203+\',\n    maxSafeTempC: 240,\n    description: \'\345\244\247\347\201\253\347\205\270\351\246\231\343\200\201\351\205\245\350\204\206\346\267\261\345\261\244\346\262\271\347\202\270\346\210\226\351\253\230\346\272\253\347\203\244\347\256\261\347\203\230\347\203\244\343\200\202\347\231\274\347\205\231\351\273\236\345\277\205\351\240\210\351\201\224\345\210\260 220\342\204\203~250\342\204\203 \344\273\245\344\270\212\357\274\214\344\270\224\350\204\202\350\202\252\351\205\270\345\277\205\351\240\210\345\205\267\345\202\231\351\253\230\346\212\227\346\260\247\345\214\226\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\347\211\271\346\200\247\343\200\202\',\n    exampleDishes: \'\351\253\230\346\272\253\351\246\231\347\205\216\345\216\232\345\210\207\347\211\233\346\216\222\343\200\201\344\270\255\345\274\217\345\244\247\347