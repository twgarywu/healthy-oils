  planner_response {
    response: "\345\267\262\347\202\272\346\202\250\345\273\272\347\275\256\345\256\214\346\210\220**\343\200\214\345\201\245\345\272\267\345\245\275\346\262\271\347\231\276\347\247\221\357\274\232\344\272\236\351\272\273\344\273\201\346\262\271\350\210\207\350\213\246\350\214\266\346\262\271\343\200\215**\345\260\210\346\245\255\345\275\242\350\261\241\350\210\207\345\257\246\350\255\211\350\241\233\346\225\231\347\237\245\350\255\230\345\272\253\347\266\262\347\253\231\357\274\214\345\256\214\346\225\264\346\266\265\350\223\213\344\273\245\344\270\213\345\205\247\345\256\271\350\210\207\345\212\237\350\203\275\357\274\232\n\n### \346\240\270\345\277\203\345\212\237\350\203\275\350\210\207\345\205\247\345\256\271\344\272\256\351\273\236\n\n1. **\350\204\202\350\202\252\351\205\270\345\205\250\350\247\243\346\236\220\357\274\210Omega-3 / 6 / 9\357\274\211**\n   - \347\263\273\347\265\261\345\211\226\346\236\220\344\270\211\347\250\256\350\204\202\350\202\252\351\205\270\347\232\204\347\224\237\345\214\226\345\210\206\345\255\220\347\211\271\346\200\247\343\200\201\345\277\205\351\234\200\346\200\247\350\210\207\351\253\224\345\205\247\344\273\243\350\254\235\350\267\257\345\276\221\357\274\210\346\266\210\351\200\200\347\264\240 Resolvins/PGE3 \346\212\227\347\231\274\347\202\216\350\267\257\345\276\221 vs PGE2 \344\277\203\347\231\274\347\202\216\350\267\257\345\276\221\357\274\211\343\200\202\n   - \350\246\226\350\246\272\345\214\226\345\221\210\347\217\276\347\217\276\344\273\243\351\243\262\351\243\237\344\270\255 Omega-6 \350\210\207 Omega-3 \351\201\224 **1:15 ~ 20** \347\232\204\345\232\264\351\207\215\345\244\261\350\241\241\345\215\261\346\251\237\357\274\214\344\270\246\346\217\220\344\276\233\351\231\215\350\207\263 **1:1 ~ 4** \351\273\203\351\207\221\346\257\224\344\276\213\347\232\204\344\270\211\346\255\245\345\257\246\350\270\220\346\226\271\346\241\210\343\200\202\n\n2. **\351\243\237\347\224\250\346\262\271\344\276\206\346\272\220\350\210\207\347\231\274\347\205\231\351\273\236\345\234\226\351\221\221 \357\274\206 \346\231\272\346\205\247\351\205\215\346\262\271\351\200\237\351\205\215\345\231\250**\n   - **\346\231\272\346\205\247\351\205\215\346\262\271\351\200\237\351\205\215\345\231\250**\357\274\232\344\275\277\347\224\250\350\200\205\345\217\257\344\276\235\346\226\231\347\220\206\346\212\200\346\263\225\357\274\210\346\266\274\346\213\214\347\224\237\351\243\262\343\200\201\346\260\264\347\202\222\347\207\211\347\205\256\343\200\201\347\206\261\347\202\222\351\246\231\347\205\216\343\200\201\345\244\247\347\201\253\347\205\216\347\202\270\357\274\211\350\210\207\345\201\245\345\272\267\350\250\264\346\261\202\357\274\210\346\212\227\347\231\274\347\202\216\343\200\201\344\277\235\350\255\267\345\277\203\350\241\200\347\256\241\343\200\201\350\255\267\350\203\203\343\200\201\350\200\220\351\253\230\346\272\253\347\204\241\346\262\271\347\205\231\357\274\211\357\274\214\345\215\263\346\231\202\350\250\210\347\256\227\345\256\211\345\205\250\346\272\253\345\272\246\350\210\207\346\216\250\350\226\246\346\262\271\345\223\201\343\200\202\n   - **\347\231\274\347\205\231\351\273\236\345\205\250\350\263\207\346\226\231\345\272\253**\357\274\232\345\256\214\346\225\264\346\224\266\351\214\204 14 \347\250\256\345\270\270\350\246\213\351\243\237\347\224\250\346\262\271\357\274\210\344\272\236\351\272\273\344\273\201\346\262\271\343\200\201\350\213\246\350\214\266\346\262\271\343\200\201\347\211\271\347\264\232\345\210\235\346\246\250\346\251\204\346\254\226\346\262\271\343\200\201\351\205\252\346\242\250\346\262\271\343\200\201\347\264\253\350\230\207\346\262\271\343\200\201\346\240\270\346\241\203\346\262\271\343\200\201\350\212\235\351\272\273\346\262\271\343\200\201\350\212\245\350\212\261\346\262\271\343\200\201\350\212\261\347\224\237\346\262\271\343\200\201\346\244\260\345\255\220\346\262\271\343\200\201\345\244\247\350\261\206\346\262\231\346\213\211\346\262\271\343\200\201\350\221\265\350\212\261\346\26