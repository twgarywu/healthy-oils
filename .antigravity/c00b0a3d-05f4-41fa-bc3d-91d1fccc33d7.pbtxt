      arguments_json: "{\"CodeContent\":\"export interface ResearchArticle {\\n  id: string;\\n  title: string;\\n  journal: string;\\n  year: number;\\n  category: \'cardio\' | \'anti_inflam\' | \'gastro\' | \'thermal\' | \'metabolic\';\\n  categoryLabel: string;\\n  authors: string;\\n  sampleSize: string;\\n  doiOrSource: string;\\n  abstractSummary: string;\\n  clinicalKeyFindings: string[];\\n  takeawayForDailyDiet: string;\\n}\\n\\nexport const RESEARCH_ARTICLES: ResearchArticle[] = [\\n  {\\n    id: \'res-nejm-predimed\',\\n    title: \'\347\211\271\347\264\232\345\210\235\346\246\250\345\245\275\346\262\271\350\210\207\345\240\205\346\236\234\345\260\215\345\277\203\350\241\200\347\256\241\351\207\215\345\244\247\344\272\213\344\273\266\344\271\213\344\270\200\347\264\232\351\240\220\351\230\262\350\207\250\345\272\212\350\251\246\351\251\227 (PREDIMED Study)\',\\n    journal: \'The New England Journal of Medicine (NEJM)\',\\n    year: 2018,\\n    category: \'cardio\',\\n    categoryLabel: \'\345\277\203\350\241\200\347\256\241\345\201\245\345\272\267\',\\n    authors: \'Estruch R, Ros E, Salas-Salvad\303\263 J, et al. for the PREDIMED Study Investigators\',\\n    sampleSize: \'7,447 \345\220\215\345\277\203\350\241\200\347\256\241\351\253\230\351\242\250\351\232\252\345\217\227\350\251\246\350\200\205\357\274\214\344\270\255\344\275\215\346\225\270\350\277\275\350\271\244 4.8 \345\271\264\',\\n    doiOrSource: \'DOI: 10.1056/NEJMoa1800389\',\\n    abstractSummary: \'\344\270\200\351\240\205\345\244\247\350\246\217\346\250\241\351\232\250\346\251\237\345\260\215\347\205\247\345\244\232\344\270\255\345\277\203\350\251\246\351\251\227\357\274\214\346\257\224\350\274\203\346\224\235\345\217\226\345\257\214\345\220\253\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252\357\274\210\347\211\271\347\264\232\345\210\235\346\246\250\351\253\230\345\244\232\351\205\232\345\245\275\346\262\271\357\274\211\345\234\260\344\270\255\346\265