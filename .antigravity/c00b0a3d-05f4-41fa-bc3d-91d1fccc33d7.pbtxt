    user_response: "\347\202\272\344\275\240\350\250\255\350\250\210\344\272\206\344\270\200\344\273\275\345\260\210\351\226\200\347\202\272 **Google AI Studio**\357\274\210\345\273\272\350\255\260\346\220\255\351\205\215 Gemini 1.5 Pro \346\250\241\345\236\213\357\274\211\346\211\223\351\200\240\347\232\204\347\265\220\346\247\213\345\214\226 Prompt\343\200\202\n\n\344\275\240\345\217\257\344\273\245\347\233\264\346\216\245\350\244\207\350\243\275\344\270\213\346\226\271\345\205\247\345\256\271\357\274\214\350\262\274\345\205\245 AI Studio \347\232\204\350\274\270\345\205\245\346\241\206\357\274\210System Instructions \346\210\226 User Prompt\357\274\211\344\270\255\345\237\267\350\241\214\357\274\232\n\n---\n\n### \350\244\207\350\243\275\344\273\245\344\270\213\345\205\247\345\256\271\350\207\263 AI Studio\357\274\232\n\n# Role & Expertise\n\n\344\275\240\346\230\257\344\270\200\344\275\215\347\262\276\351\200\232\343\200\214\347\217\276\344\273\243\347\207\237\351\244\212\347\247\221\345\255\270\343\200\215\350\210\207\343\200\214\347\217\276\344\273\243\351\237\277\346\207\211\345\274\217\345\211\215\347\253\257\347\266\262\351\240\201\351\226\213\347\231\274\357\274\210UI/UX\357\274\211\343\200\215\347\232\204\345\260\210\345\256\266\343\200\202\350\253\213\345\215\224\345\212\251\346\210\221\350\246\217\345\212\203\344\270\246\347\224\237\346\210\220\344\270\200\345\200\213\344\273\245\343\200\214\345\201\245\345\272\267\345\245\275\346\262\271\347\231\276\347\247\221\357\274\232\344\272\236\351\272\273\344\273\201\346\262\271\350\210\207\350\213\246\350\214\266\346\262\271\343\200\215\347\202\272\346\240\270\345\277\203\344\270\273\351\241\214\347\232\204\345\260\210\346\245\255\345\275\242\350\261\241\347\266\262\347\253\231\343\200\202\n\n# Target Audience\n\n\350\277\275\346\261\202\346\212\227\347\231\274\347\202\216\351\243\262\351\243\237\343\200\201\351\207\215\350\246\226\345\277\203\350\241\200\347\256\241\345\201\245\345\272\267\343\200\201\347\224\237\351\205\256/\344\275\216\347\242\263\351\243\262\351\243\237\350\200\205\357\274\214\344\273\245\345\217\212\345\270\214\346\234\233\347\202\272\345\205\250\345\256\266\344\272\272\346\214\221\351\201\270\345\256\211\345\277\203\351\243\237\347\224\250\346\262\271\347\232\204\345\256\266\345\272\255\346\216\241\350\262\267\350\200\205\343\200\202\n\n# Design & Tone\n\n* \351\242\250\346\240\274\357\274\232\350\207\252\347\204\266\347\264\224\346\267\250\343\200\201\347\217\276\344\273\243\347\260\241\347\264\204\343\200\201\345\205\267\345\202\231\351\206\253\345\255\270\350\210\207\347\207\237\351\244\212\345\260\210\346\245\255\345\205\254\344\277\241\345\212\233\343\200\202\n* \350\211\262\347\263\273\345\273\272\350\255\260\357\274\232\346\251\204\346\254\226\347\266\240\343\200\201\345\206\267\345\243\223\345\210\235\346\246\250\351\207\221\351\273\203\350\211\262\343\200\201\346\272\253\346\232\226\347\261\263\347\231\275\350\210\207\346\267\261\347\201\260\346\226\207\345\255\227\343\200\202\n* \346\212\200\350\241\223\350\246\217\347\257\204\357\274\232\350\253\213\347\233\264\346\216\245\350\274\270\345\207\272\345\226\256\344\270\200\345\256\214\346\225\264\347\232\204 HTML \346\252\224\346\241\210\357\274\210\344\275\277\347\224\250 Tailwind CSS CDN \350\210\207 FontAwesome \345\234\226\347\244\272\357\274\214\346\224\257\346\217\264\346\211\213\346\251\237\350\210\207\346\241\214\346\251\237 RWD \351\237\277\346\207\211\345\274\217\344\275\210\345\261\200\357\274\211\343\200\202\n\n# Core Content Modules & Requirements\n\n\350\253\213\347\242\272\344\277\235\351\240\201\351\235\242\345\256\214\346\225\264\346\266\265\350\223\213\344\273\245\344\270\213 5 \345\244\247\346\240\270\345\277\203\345\215\200\345\241\212\357\274\232\n\n1. **\350\204\202\350\202\252\351\205\270\345\205\250\350\247\243\346\236\220\357\274\232\350\252\215\350\255\230 Omega-3\343\200\2016\343\200\2019**\n* \346\267\261\345\205\245\346\267\272\345\207\272\350\247\243\351\207\21