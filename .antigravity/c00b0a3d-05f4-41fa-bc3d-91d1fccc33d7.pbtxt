      create_file {
        instruction: "import React from \'react\';\nimport { ArrowDown, Flame, ShieldCheck, HeartHandshake, BookOpen } from \'lucide-react\';\n\ninterface HeroProps {\n  onExploreMatcher: () => void;\n  onExploreDualStars: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onExploreMatcher, onExploreDualStars }) => {\n  return (\n    <section className=\"relative overflow-hidden pt-8 pb-16 md:pt-16 md:pb-24 border-b border-stone-200/60 bg-gradient-to-b from-[#FAF8F5] via-[#F6F2EB] to-[#FAF8F5]\">\n      {/* Subtle organic botanical background accents */}\n      <div className=\"absolute top-0 right-0 -translate-y-12 translate-x-1/4 w-96 h-96 bg-amber-200/25 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute bottom-0 left-0 translate-y-12 -translate-x-1/4 w-96 h-96 bg-emerald-200/20 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center\">\n          {/* Left Column: Editorial Headline & Narrative */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            {/* Quiet text kicker with typographic separator */}\n            <div className=\"flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-amber-800\">\n              <span>\347\217\276\344\273\243\347\207\237\351\244\212\347\224\237\345\214\226\347\247\221\345\255\270</span>\n              <span aria-hidden=\"true\" className=\"text-stone-400\">\302\267</span>\n              <span>\345\205\250\346\226\271\344\275\215\351\243\237\347\224\250\346\262\271\346\214\207\345\215\227</span>\n              <span aria-hidden=\"true\" className=\"text-stone-400\">\302\267</span>\n              <span>2026 \346\254\212\345\250\201\345\257\246\350\255\211\347\211\210</span>\n            </div>\n\n            <h1 className=\"font-display text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-stone-900 tracking-tight leading-[1.18] [text-wrap:balance]\">\n              \346\211\223\347\240\264\343\200\214\345\260\221\346\262\271\343\200\215\350\277\267\346\200\235\357\274\214\n              <br />\n              \347\224\250<span className=\"text-amber-800 underline decoration-amber-600/30 decoration-wavy underline-offset-8\">\347\247\221\345\255\270\351\201\270\345\245\275\346\262\271</span>\345\225\237\345\213\225\345\205\250\350\272\253\346\212\227\347\231\274\347\202\216\351\230\262\347\246\246\n            </h1>\n\n            <p className=\"text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl\">\n              \347\217\276\344\273\243\344\272\272\345\244\226\351\243\237\345\205\205\346\226\245\351\201\216\351\207\217 Omega-6\357\274\214\344\277\203\344\275\277\351\253\224\345\205\247\351\225\267\346\234\237\350\231\225\346\226\274\346\205\242\346\200\247\345\276\256\347\231\274\347\202\216\347\213\200\346\205\213\343\200\202\n              \346\267\261\345\205\245\346\216\242\350\250\216\346\244\215\347\211\251\346\200\247 Omega-3 \344\271\213\347\216\213\343\200\214<strong className=\"text-stone-900 font-semibold\">\344\272\236\351\272\273\344\273\201\346\262\271</strong>\343\200\215\350\210\207\346\235\261\346\226\271\350\200\220\351\253\230\346\272\253\346\266\262\351\253\224\351\273\203\351\207\221\343\200\214<strong className=\"text-stone-900 font-semibold\">\350\213\246\350\214\266\346\262\271</strong>\343\200\215\357\274\214\346\216\214\346\217\241\344\272\272\351\253\224\350\204\202\350\202\252\351\205\270\351\273\203\351\207\221\345\271\263\350\241\241\350\210\207\347\203\271\350\252\277\347\231\274\347\205\231\351\273\236\357\274\214\347\202\272\345\205\250\345\256\266\344\272\272\346\214\221\351\201\270\347\234\237\346\255\243\345\256\211\345\277\203\347\232\204\345\201\245\345\272\267\346\262\271\350\204\202\343\200\202\n            </p>\n\n            {/* Action buttons */}\n            <div className=\"flex flex-wrap items-center gap-4 pt-2\">\n              <button\n                onClick={onExploreMatcher}\n                className=\"px-6 py-3.5 text-sm font-semibold text-white bg-amber-800 hover:bg-amber-900 active:bg-amber-950 rounded-lg shadow-sm hover:shadow transition-all duration-200 flex items-center gap-2\"\n              >\n                <Flame className=\"w-4 h-4 text-amber-300\" />\n                <span>\347\253\213\345\215\263\351\253\224\351\251\227\346\231\272\346\205\247\351\205\215\346\262\271\351\200\237\351\205\215\345\231\250</span>\n              </button>\n              <button\n                onClick={onExploreDualStars}\n                className=\"px-6 py-3.5 text-sm font-semibold text-stone-700 hover:text-stone-900 bg-white hover:bg-stone-50 border border-stone-300/80 rounded-lg transition-all duration-200 flex items-center gap-2 shadow-xs\"\n              >\n                <BookOpen className=\"w-4 h-4 text-emerald-700\" />\n                <span>\346\267\261\345\205\245\346\216\242\347\264\242\351\233\231\346\230\237\344\270\273\350\247\222</span>\n              </button>\n            </div>\n\n            {/* Claim-to-proof mini trust markers */}\n            <div className=\"pt-4 border-t border-stone-200/80 flex flex-wrap items-center gap-6 text-xs text-stone-500\">\n              <div className=\"flex items-center gap-1.5\">\n                <ShieldCheck className=\"w-4 h-4 text-emerald-700 shrink-0\" />\n                <span>\345\234\213\351\232\233\346\254\212\345\250\201\351\206\253\345\255\270\346\234\237\345\210\212\345\257\246\350\255\211\357\274\210NEJM / Lancet\357\274\211</span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <HeartHandshake className=\"w-4 h-4 text-amber-700 shrink-0\" />\n                <span>\350\241\233\347\246\217\351\203\250\345\234\213\345\201\245\347\275\262\351\243\262\351\243\237\350\204\202\350\263\252\350\241\233\346\225\231\344\276\235\346\223\232</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Handcrafted Botanical Oil Showcase Illustration */}\n          <div className=\"lg:col-span-5\">\n            <div className=\"relative mx-auto max-w-md lg:max-w-none bg-gradient-to-br from-white to-[#F9F7F3] rounded-2xl p-6 sm:p-8 border border-stone-200/90 shadow-sm\">\n              {/* Botanical badge */}\n              <div className=\"flex items-center justify-between pb-6 border-b border-stone-200\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-2.5 h-2.5 rounded-full bg-amber-600\" />\n                  <span className=\"font-display font-semibold text-sm text-stone-800\">\n                    \351\233\231\346\230\237\344\270\273\350\247\222\346\240\270\345\277\203\346\214\207\346\250\231\345\260\215\347\205\247\n                  </span>\n                </div>\n                <span className=\"text-xs text-stone-400 font-mono\">EDITION 2026</span>\n              </div>\n\n              {/* Graphic Botanical Drops Card */}\n              <div className=\"py-6 space-y-4\">\n                {/* Flaxseed Oil Card */}\n                <div className=\"p-4 rounded-xl bg-amber-50/70 border border-amber-200/60 transition-all hover:bg-amber-50\">\n                  <div className=\"flex items-start justify-between gap-3\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-10 h-10 rounded-lg bg-amber-800 text-white flex items-center justify-center font-display font-bold text-base shadow-xs\">\n                        \316\2513\n                      </div>\n                      <div>\n                        <h2 className=\"font-display font-bold text-stone-900 text-base\">\n                          \345\206\267\345\243\223\344\272\236\351\272\273\344\273\201\346\262\271\n                        </h2>\n                        <p className=\"text-xs text-stone-500\">\n                          \346\244\215\347\211\251\346\200\247 Omega-3 (ALA) \344\271\213\347\216\213\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"text-right\">\n                      <span className=\"block text-xl font-bold font-mono text-amber-900 tabular-nums\">\n                        55%\n                      </span>\n                      <span className=\"text-[11px] text-stone-500\">\316\261-\344\272\236\351\272\273\351\205\270\345\220\253\351\207\217</span>\n                    </div>\n                  </div>\n                  <div className=\"mt-3 pt-2.5 border-t border-amber-200/60 flex items-center justify-between text-xs text-amber-900/80\">\n                    <span>\347\231\274\347\205\231\351\273\236\357\274\232<strong className=\"font-mono text-stone-900\">107\342\204\203</strong>\357\274\210\345\232\264\347\246\201\351\253\230\346\272\253\345\212\240\347\206\261\357\274\211</span>\n                    <span className=\"text-amber-800 font-medium\">\351\201\251\345\220\210\357\274\232\347\224\237\351\243\262\346\266\274\346\213\214</span>\n                  </div>\n                </div>\n\n                {/* Camellia Oil Card */}\n                <div className=\"p-4 rounded-xl bg-emerald-50/60 border border-emerald-200/60 transition-all hover:bg-emerald-50\">\n                  <div className=\"flex items-start justify-between gap-3\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-10 h-10 rounded-lg bg-emerald-800 text-white flex items-center justify-center font-display font-bold text-base shadow-xs\">\n                        \316\2519\n                      </div>\n                      <div>\n                        <h2 className=\"font-display font-bold text-stone-900 text-base\">\n                          \345\206\267\345\243\223\350\213\246\350\214\266\346\262\271\n                        </h2>\n                        <p className=\"text-xs text-stone-500\">\n                          \346\235\261\346\226\271\346\266\262\351\253\224\351\273\203\351\207\221 / \350\255\267\350\203\203\351\253\230\346\272\253\345\205\250\350\203\275\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"text-right\">\n                      <span className=\"block text-xl font-bold font-mono text-emerald-900 tabular-nums\">\n                        252\342\204\203\n                      </span>\n                      <span className=\"text-[11px] text-stone-500\">\346\245\265\351\253\230\347\231\274\347\205\231\351\273\236</span>\n                    </div>\n                  </div>\n                  <div className=\"mt-3 pt-2.5 border-t border-emerald-200/60 flex items-center justify-between text-xs text-emerald-900/80\">\n                    <span>\345\226\256\345\205\203\346\262\271\351\205\270\357\274\232<strong className=\"font-mono text-stone-900\">82%</strong>\357\274\210\345\213\235\346\251\204\346\254\226\346\262\271\357\274\211</span>\n                    <span className=\"text-emerald-800 font-medium\">\351\201\251\345\220\210\357\274\232\347\205\216\347\202\222\347\202\270\347\224\237\351\243\262</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Bottom Botanical Note */}\n              <div className=\"pt-2 text-center\">\n                <p className=\"text-xs text-stone-500 italic\">\n                  \343\200\214\351\201\270\345\260\215\345\245\275\346\262\271\357\274\214\350\256\223\346\257\217\344\270\200\351\244\220\347\203\271\350\252\277\351\203\275\346\230\257\345\260\215\350\241\200\347\256\241\350\210\207\347\264\260\350\203\236\350\206\234\347\232\204\346\267\261\345\261\244\346\273\213\351\244\212\343\200\202\343\200\215\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        