72\253\346\275\244\345\233\236\347\224\230\',\\n    healthHighlights: [\\n      \'\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252\351\205\270 (\346\262\271\351\205\270 Omega-9) \351\253\230\351\201\224 82%\357\274\214\345\252\262\347\276\216\347\224\232\350\207\263\350\266\205\350\266\212\347\211\271\347\264\232\346\251\204\346\254\226\346\262\271\',\\n      \'\347\231\274\347\205\231\351\273\236\351\253\230\351\201\224 252\342\204\203\357\274\214\346\245\265\347\253\257\351\253\230\346\272\253\344\270\213\345\271\276\347\204\241\346\262\271\347\205\231\357\274\214\346\262\271\350\204\202\344\270\215\346\230\223\350\243\202\350\247\243\350\256\212\350\263\252\',\\n      \'\345\257\214\345\220\253\350\214\266\345\244\232\351\205\232 (Tea Polyphenols)\343\200\201\350\247\222\351\257\212\347\203\257 (Squalene) \350\210\207\345\261\261\350\214\266\347\232\202\350\213\267\',\\n      \'\350\207\250\345\272\212\350\255\211\345\257\246\350\203\275\345\242\236\345\274\267\350\203\203\351\273\217\350\206\234\351\230\262\347\246\246\350\203\275\345\212\233\357\274\214\346\224\271\345\226\204\350\203\203\351\205\270\351\201\216\345\244\232\350\210\207\346\266\210\345\214\226\351\201\223\344\270\215\351\201\251\',\\n      \'\351\201\251\345\220\210\344\272\236\346\264\262\344\272\272\351\253\230\346\272\253\347\203\271\350\252\277\347\277\222\346\205\243\347\232\204\345\205\250\346\226\271\344\275\215\345\201\245\345\272\267\347\245\236\346\262\271\'\\n    ],\\n    caution: \'\345\270\202\345\224\256\345\270\270\346\234\211\344\273\245\345\244\247\350\261\206\346\262\271\350\252\277\345\222\214\344\271\213\345\212\243\350\263\252\344\275\216\345\203\271\350\213\246\350\214\266\346\262\271\357\274\214\351\201\270\350\263\274\351\234\200\347\242\272\350\252\215 100% \347\211\251\347\220\206\345\206\267\345\243\223\347\264\224\345\272\246\350\210\207\351\205\270\345\203\271\346\252\242\351\251\227\343\200\202\',\\n    storageRequirement: \'\347\