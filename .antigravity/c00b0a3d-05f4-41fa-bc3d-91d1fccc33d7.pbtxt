46\207\211\344\277\203\344\275\277\347\265\204\347\271\224\347\231\222\345\220\210\',\\n      \'\350\252\277\347\257\200\350\241\200\345\243\223\350\210\207\350\241\200\346\266\262\345\207\235\345\233\272\345\210\235\345\247\213\346\251\237\345\210\266\'\\n    ],\\n    clinicalRisksOfImbalance: \'\351\201\216\351\207\217\346\234\203\350\210\207 Omega-3 \347\253\266\347\210\255\345\220\214\344\270\200\345\245\227\345\216\273\351\243\275\345\222\214\351\205\266 (Delta-6 Desaturase)\357\274\214\344\275\277\344\272\272\351\253\224\351\225\267\346\234\237\350\231\225\346\226\274\343\200\214\346\205\242\346\200\247\344\277\203\347\231\274\347\202\216\343\200\215\351\253\224\350\263\252\357\274\214\345\274\225\347\231\274\345\277\203\350\241\200\347\256\241\347\241\254\345\214\226\343\200\201\350\207\252\351\253\224\345\205\215\347\226\253\344\272\242\351\200\262\350\210\207\344\273\243\350\254\235\347\227\207\345\200\231\347\276\244\343\200\202\',\\n    cookingPrecaution: \'\345\220\253 2 \345\200\213\344\270\215\351\243\275\345\222\214\351\233\231\351\215\265\357\274\214\351\253\230\346\272\253\351\200\243\347\272\214\346\262\271\347\202\270\346\230\223\350\243\202\350\247\243\347\224\242\347\224\237\346\234\211\346\257\222\351\206\233\351\241\236 (Aldehydes) \350\210\207\351\201\216\346\260\247\345\214\226\347\211\251\343\200\202\'\\n  },\\n  {\\n    id: \'omega-9\',\\n    name: \'Omega-9 \350\204\202\350\202\252\351\205\270\',\\n    chemicalName: \'\346\262\271\351\205\270 (Oleic Acid, OA 18:1)\',\\n    category: \'Omega-9\',\\n    type: \'\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214 (MUFA)\',\\n    isEssential: false,\\n    idealDailyIntake: \'\344\275\224\346\257\217\346\227\245\347\270\275\350\204\202\350\202\252\346\224\235\345\217\226\351\207\217 50% ~ 70%\',\\n    biologicalAction: \'\345\277\203\350\241\200\347\256\241\347\266\255\350\255\267 / \346\212\227\346\260\247\345\214\226\347\251\251\345\256\232\',\\n    modernIntakeStatus: \'\346\224\23