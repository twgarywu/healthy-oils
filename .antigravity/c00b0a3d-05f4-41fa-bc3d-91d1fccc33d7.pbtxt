        instruction: "import React, { useState } from \'react\';\nimport { Menu, X, Sparkles } from \'lucide-react\';\n\ninterface NavbarProps {\n  onOpenMatcher: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onOpenMatcher }) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const navLinks = [\n    { name: \'\350\204\202\350\202\252\351\205\270\350\247\243\346\236\220\', href: \'#fatty-acids\' },\n    { name: \'\347\231\274\347\205\231\351\273\236\345\234\226\351\221\221\', href: \'#smoke-points\' },\n    { name: \'\351\233\231\346\230\237\344\270\273\350\247\222\', href: \'#dual-stars\' },\n    { name: \'\351\201\270\346\262\271\344\272\224\346\263\225\', href: \'#buying-guide\' },\n    { name: \'\347\247\221\347\240\224\346\203\205\345\240\261\', href: \'#research-hub\' },\n  ];\n\n  const handleLinkClick = (href: string) => {\n    setMobileMenuOpen(false);\n    const element = document.querySelector(href);\n    if (element) {\n      element.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-md border-b border-stone-200/80 transition-all\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between gap-8 h-18\">\n          {/* Zone 1: Brand Wordmark (Single Text Element) */}\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2.5 text-stone-900 group whitespace-nowrap shrink-0\"\n          >\n            <div className=\"w-8 h-8 rounded-full bg-amber-700/10 flex items-center justify-center text-amber-700 border border-amber-600/20 group-hover:bg-amber-700 group-hover:text-white transition-colors duration-200\">\n              <svg className=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\">\n                <path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\" />\n              </svg>\n            </div>\n            <div>\n              <span className=\"font-display text-xl font-bold tracking-tight text-stone-900 block leading-tight\">\n                \345\201\245\345\272\267\345\245\275\346\262\271\347\231\276\347\247\221\n              </span>\n              <span className=\"text-[10px] uppercase tracking-wider text-stone-500 font-sans block\">\n                Health Oil Encyclopedia\n              </span>\n            </div>\n          </a>\n\n          {/* Zone 2: Clean 5-link text navigation */}\n          <nav className=\"hidden lg:flex items-center gap-7 text-sm font-medium text-stone-600\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                onClick={(e) => {\n                  e.preventDefault();\n                  handleLinkClick(link.href);\n                }}\n                className=\"whitespace-nowrap shrink-0 hover:text-amber-700 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-amber-700 hover:after:w-full after:transition-all after:duration-200\"\n              >\n                {link.name}\n              </a>\n            ))}\n          </nav>\n\n          {/* Zone 3: Primary Action Button */}\n          <div className=\"hidden sm:flex items-center gap-3 shrink-0\">\n            <button\n              onClick={onOpenMatcher}\n              className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-amber-800 hover:bg-amber-900 active:bg-amber-950 rounded-lg shadow-sm hover:shadow transition-all duration-200 whitespace-nowrap shrink-0\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-300\" />\n              <span>\346\231\272\346\205\247\351\205\215\346\262\271\351\200\237\351\205\215\345\231\250</span>\n            </button>\n          </div>\n\n          {/* Mobile Menu Hamburger */}\n          <div className=\"flex sm:hidden items-center\">\n            <button\n              type=\"button\"\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 rounded-lg text-stone-700 hover:text-stone-900 hover:bg-stone-200/50 transition-colors\"\n              aria-label=\"Toggle Navigation Menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Drawer */}\n      {mobileMenuOpen && (\n        <div className=\"sm:hidden border-b border-stone-200 bg-[#FAF8F5] px-4 pt-2 pb-6 space-y-3\">\n          <div className=\"flex flex-col space-y-2 pt-2\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                onClick={(e) => {\n                  e.preventDefault();\n                  handleLinkClick(link.href);\n                }}\n                className=\"px-3 py-2 text-base font-medium text-stone-700 hover:text-amber-800 hover:bg-amber-50 rounded-md transition-colors\"\n              >\n                {link.name}\n              </a>\n            ))}\n          </div>\n          <div className=\"pt-2 border-t border-stone-200\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenMatcher();\n              }}\n              className=\"w-full flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-amber-800 hover:bg-amber-900 rounded-lg shadow-sm\"\n            >\n              <Sparkles className=\"w-4 h-4 text-amber-300\" />\n              <span>\351\226\213\345\225\237\346\231\272\346\205\247\351\205\215\346\262\271\351\200\237\351\205\215\345\231\250</span>\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
