      create_file {
        instruction: "import React, { useState, useMemo } from \'react\';\nimport { RESEARCH_ARTICLES, ResearchArticle } from \'../data/researchData.ts\';\nimport { BookOpen, ExternalLink, Calendar, Users, Award, X, ChevronRight, FileText } from \'lucide-react\';\n\nexport const ResearchHub: React.FC = () => {\n  const [activeCategory, setActiveCategory] = useState<string>(\'all\');\n  const [selectedModalArticle, setSelectedModalArticle] = useState<ResearchArticle | null>(null);\n\n  const categories = [\n    { id: \'all\', label: \'\345\205\250\351\203\250\347\247\221\347\240\224\346\226\207\347\215\273\' },\n    { id: \'cardio\', label: \'\345\277\203\350\241\200\347\256\241\345\201\245\345\272\267\' },\n    { id: \'anti_inflam\', label: \'\346\212\227\347\231\274\347\202\216\346\212\227\346\260\247\345\214\226\' },\n    { id: \'gastro\', label: \'\346\266\210\345\214\226\351\201\223\344\277\256\345\276\251\' },\n    { id: \'thermal\', label: \'\347\203\271\351\243\252\347\206\261\347\251\251\345\256\232\' },\n  ];\n\n  const filteredArticles = useMemo(() => {\n    if (activeCategory === \'all\') return RESEARCH_ARTICLES;\n    return RESEARCH_ARTICLES.filter((a) => a.category === activeCategory);\n  }, [activeCategory]);\n\n  return (\n    <section id=\"research-hub\" className=\"py-16 md:py-24 bg-white border-b border-stone-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Section Header */}\n        <div className=\"max-w-3xl mb-12\">\n          <div className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-amber-800 mb-2\">\n            <span>\346\250\241\347\265\204 05</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\345\234\213\351\232\233\351\206\253\345\255\270\350\210\207\347\247\221\347\240\224\346\203\205\345\240\261</span>\n          </div>\n          <h2 className=\"font-display text-2xl sm:text-3xl md:text-4xl font-bold text-stone-900 tracking-tight leading-snug [text-wrap:balance]\">\n            \345\234\213\345\205\247\345\244\226\346\262\271\345\223\201\350\210\207\345\201\245\345\272\267\345\215\263\346\231\202\346\203\205\345\240\261\357\274\232\345\220\214\345\204\225\345\257\251\346\237\245\347\247\221\347\240\224\345\277\253\350\250\212\n          </h2>\n          <p className=\"mt-3 text-stone-600 text-base leading-relaxed\">\n            \345\232\264\351\201\270\347\231\274\350\241\250\346\226\274\343\200\212\346\226\260\350\213\261\346\240\274\350\230\255\351\206\253\345\255\270\346\234\237\345\210\212 (NEJM)\343\200\213\343\200\201\343\200\212\345\210\272\350\203\263\351\207\235 (The Lancet)\343\200\213\343\200\201\343\200\212\347\276\216\345\234\213\345\277\203\350\207\237\345\215\224\346\234\203 (AHA)\343\200\213\345\217\212\350\241\233\347\246\217\351\203\250\345\234\213\345\201\245\347\275\262\344\271\213\345\257\246\350\255\211\346\226\207\347\215\273\357\274\214\346\235\234\347\265\225\346\234\252\347\266\223\350\255\211\345\257\246\347\232\204\346\260\221\351\226\223\345\201\217\346\226\271\357\274\214\344\273\245\345\232\264\350\254\271\346\225\270\346\223\232\351\200\217\350\246\226\346\262\271\350\204\202\347\207\237\351\244\212\347\234\237\347\233\270\343\200\202\n          </p>\n        </div>\n\n        {/* Category Filter Tabs */}\n        <div className=\"flex flex-wrap items-center gap-2 pb-6 border-b border-stone-200/80 mb-8\">\n          {categories.map((cat) => (\n            <button\n              key={cat.id}\n              onClick={() => setActiveCategory(cat.id)}\n              className={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${\n                activeCategory === cat.id\n                  ? \'bg-amber-800 text-white shadow-xs\'\n                  : \'bg-stone-100 text-stone-600 hover:text-stone-900 hover:bg-stone-200/60\'\n              }`}\n            >\n              {cat.label}\n            </button>\n          ))}\n          <span className=\"text-xs text-stone-400 ml-auto hidden sm:inline\">\n            \345\205\261\346\224\266\351\214\204 {filteredArticles.length} \347\257\207\346\254\212\345\250\201\346\226\207\347\215\273\n          </span>\n        </div>\n\n        {/* Articles Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {filteredArticles.map((article) => (\n            <div\n              key={article.id}\n              className=\"bg-[#FAF8F5] border border-stone-200 rounded-2xl p-6 flex flex-col justify-between hover:border-amber-700/40 hover:shadow-sm transition-all group\"\n            >\n              <div className=\"space-y-4\">\n                {/* Journal & Year (Unboxed Metadata per Zero-Pill rule) */}\n                <div className=\"flex items-center gap-2 text-xs text-stone-500 font-sans\">\n                  <span className=\"font-semibold text-amber-900\">{article.categoryLabel}</span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>{article.journal.split(\'(\')[0].trim()}</span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span className=\"font-mono\">{article.year}</span>\n                </div>\n\n                {/* Article Title */}\n                <h3 className=\"font-display font-bold text-base sm:text-lg text-stone-900 group-hover:text-amber-900 transition-colors leading-snug\">\n                  {article.title}\n                </h3>\n\n                {/* Abstract summary */}\n                <p className=\"text-xs text-stone-600 leading-relaxed line-clamp-3\">\n                  {article.abstractSummary}\n                </p>\n\n                {/* Sample Size */}\n                <div className=\"flex items-center gap-2 text-xs text-stone-500 pt-2 border-t border-stone-200/70\">\n                  <Users className=\"w-3.5 h-3.5 text-stone-400 shrink-0\" />\n                  <span className=\"truncate\">{article.sampleSize}</span>\n                </div>\n              </div>\n\n              {/* Action Button */}\n              <div className=\"pt-4 mt-4 border-t border-stone-200/60 flex items-center justify-between\">\n                <span className=\"text-[11px] font-mono text-stone-400\">\n                  {article.doiOrSource.split(\'/\')[0]}\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => setSelectedModalArticle(article)}\n                  className=\"inline-flex items-center gap-1 text-xs font-semibold text-amber-800 hover:text-amber-950 transition-colors\"\n                >\n                  <span>\351\226\261\350\256\200\350\207\250\345\272\212\350\246\201\351\273\236</span>\n                  <ChevronRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Modal: Full Article Clinical Detail */}\n        {selectedModalArticle && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-900/60 backdrop-blur-xs\">\n            <div className=\"bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto border border-stone-200 shadow-xl p-6 sm:p-8 relative\">\n              {/* Close Button */}\n              <button\n                type=\"button\"\n                onClick={() => setSelectedModalArticle(null)}\n                className=\"absolute top-5 right-5 p-2 rounded-lg text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition-colors\"\n                aria-label=\"Close modal\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"space-y-6\">\n                <div>\n                  <div className=\"flex items-center gap-2 text-xs text-stone-500 font-sans mb-1\">\n                    <span className=\"font-semibold text-amber-900\">\n                      {selectedModalArticle.categoryLabel}\n                    </span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span>{selectedModalArticle.journal}</span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span className=\"font-mono\">{selectedModalArticle.year} \345\271\264\347\231\274\350\241\250</span>\n                  </div>\n                  <h3 className=\"font-display text-xl sm:text-2xl font-bold text-stone-900 leading-snug\">\n                    {selectedModalArticle.title}\n                  </h3>\n                  <p className=\"text-xs text-stone-500 mt-2 font-sans\">\n                    \347\240\224\347\251\266\345\255\270\350\200\205\357\274\232{selectedModalArticle.authors}\n                  </p>\n                </div>\n\n                {/* Cohort / Sample Size */}\n                <div className=\"p-3.5 rounded-xl bg-stone-50 border border-stone-200 text-xs text-stone-700\">\n                  <strong className=\"text-stone-900\">\347\240\224\347\251\266\350\250\255\350\250\210\350\210\207\345\217\227\350\251\246\346\250\243\346\234\254\357\274\232</strong>{\' \'}\n                  {selectedModalArticle.sampleSize}\n                </div>\n\n                {/* Clinical Key Findings */}\n                <div className=\"space-y-2\">\n                  <h4 className=\"text-xs uppercase tracking-wider font-semibold text-stone-500 font-sans\">\n                    \345\220\214\345\204\225\345\257\251\346\237\245\346\240\270\345\277\203\350\207\250\345\272\212\347\231\274\347\217\276\n                  </h4>\n                  <div className=\"space-y-2\">\n                    {selectedModalArticle.clinicalKeyFindings.map((finding, idx) => (\n                      <div\n                        key={idx}\n                        className=\"p-3 rounded-lg bg-emerald-50/50 border border-emerald-100 text-xs sm:text-sm text-stone-800 leading-relaxed\"\n                      >\n                        {finding}\n         