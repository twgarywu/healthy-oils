\271\350\210\207\346\210\220\347\206\237\351\205\252\346\242\250\351\246\231\346\260\243\',\\n    healthHighlights: [\\n      \'\346\211\200\346\234\211\351\243\237\347\224\250\346\244\215\347\211\251\346\262\271\344\270\255\347\231\274\347\205\231\351\273\236\346\234\200\351\253\230\344\271\213\344\270\200 (\351\201\224 271\342\204\203)\',\\n      \'\345\257\214\345\220\253\350\221\211\351\273\203\347\264\240 (Lutein)\357\274\214\346\234\211\345\212\251\347\234\274\347\235\233\351\273\203\346\226\221\351\203\250\346\212\227\350\227\215\345\205\211\344\277\235\350\255\267\',\\n      \'\346\245\265\344\275\263\347\232\204\351\253\230\346\272\253\345\214\226\345\255\270\347\251\251\345\256\232\346\200\247\350\210\207\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252\351\205\270\'\\n    ],\\n    caution: \'\346\234\252\347\262\276\347\205\211\345\210\235\346\246\250\351\205\252\346\242\250\346\262\271\351\241\217\350\211\262\346\267\261\347\266\240\357\274\214\350\213\245\347\266\223\345\214\226\345\255\270\347\262\276\347\205\211\345\211\207\347\207\237\351\244\212\346\265\201\345\244\261\343\200\202\',\\n    storageRequirement: \'\351\201\277\345\205\211\345\270\270\346\272\253\344\277\235\345\255\230\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'perilla-oil\',\\n    name: \'\345\206\267\345\243\223\347\264\253\350\230\207\347\261\275\346\262\271\',\\n    englishName: \'Cold-Pressed Perilla Seed Oil\',\\n    smokePointC: 105,\\n    smokePointF: 221,\\n    sfaPercent: 8,\\n    mufaPercent: 14,\\n    pufaPercent: 78,\\n    omega3Percent: 62,\\n    omega6Percent: 16,\\n    thermalStability: \'\346\245\265\344\275\216 (\345\232\264\347\246\201\345\212\240\347\206\261)\',\\n    suitableCooking: [\'raw\'],\\n    cookingDescriptions: [\'\346\231\250\351\226\223\347\251\272\350\205\271\347\224\237\351\243\262\', \'\351\237\223\345\274\217\346\266\274\346\213\214\345\260\217\350\217\234\350\210\207\346\262\231\346\213\211\'