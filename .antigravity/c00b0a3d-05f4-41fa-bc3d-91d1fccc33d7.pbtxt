  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 126
    content: "import React, { useState } from \'react\';\nimport { Navbar, MAIN_TABS } from \'./components/Navbar.tsx\';\nimport { Hero } from \'./components/Hero.tsx\';\nimport { HealthQuizLanding } from \'./components/HealthQuizLanding.tsx\';\nimport { FattyAcidSection } from \'./components/FattyAcidSection.tsx\';\nimport { SmokePointGuide } from \'./components/SmokePointGuide.tsx\';\nimport { DualStarSpotlight } from \'./components/DualStarSpotlight.tsx\';\nimport { BuyingGuide } from \'./components/BuyingGuide.tsx\';\nimport { ResearchHub } from \'./components/ResearchHub.tsx\';\nimport { Footer } from \'./components/Footer.tsx\';\nimport { ChevronLeft, ChevronRight, BookOpen } from \'lucide-react\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<string>(\'home\');\n\n  const currentTabIndex = MAIN_TABS.findIndex((t) => t.id === activeTab);\n  const prevTab = currentTabIndex > 0 ? MAIN_TABS[currentTabIndex - 1] : null;\n  const nextTab = currentTabIndex < MAIN_TABS.length - 1 ? MAIN_TABS[currentTabIndex + 1] : null;\n\n  const handleSelectTab = (tabId: string) => {\n    setActiveTab(tabId);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-[#FAF8F5] text-stone-900 selection:bg-amber-200 selection:text-amber-950 font-sans\">\n      {/* Top Bar with Prominent Big Tab Buttons */}\n      <Navbar currentTab={activeTab} onSelectTab={handleSelectTab} />\n\n      {/* Main Tab-Based Page Container */}\n      <main className=\"flex-1\">\n        {/* TAB 1: HOME & INTERACTIVE GUIDED SELF-ASSESSMENT */}\n        {activeTab === \'home\' && (\n          <div>\n            <Hero\n              onExploreMatcher={() => handleSelectTab(\'smoke_points\')}\n              onExploreDualStars={() => handleSelectTab(\'dual_stars\')}\n            />\n            {/* Guided Hook Questions Self-Assessment */}\n            <HealthQuizLanding onNavigateTab={handleSelectTab} />\n          </div>\n        )}\n\n        {/* TAB 2: FATTY ACIDS BIOCHEMISTRY (OMEGA 3 / 6 / 9) */}\n        {activeTab === \'fatty_acids\' && (\n          <div>\n            <FattyAcidSection />\n          </div>\n        )}\n\n        {/* TAB 3: SMOKE POINTS ATLAS & COOKING MATCHER */}\n        {activeTab === \'smoke_points\' && (\n          <div>\n            <SmokePointGuide />\n          </div>\n        )}\n\n        {/* TAB 4: DUAL STARS SPOTLIGHT (FLAXSEED & CAMELLIA SEED OILS) */}\n        {activeTab === \'dual_stars\' && (\n          <div>\n            <DualStarSpotlight />\n          </div>\n        )}\n\n        {/* TAB 5: 5-STEP EXPERT BUYING & INSPECTION GUIDE */}\n        {activeTab === \'buying_guide\' && (\n          <div>\n            <BuyingGuide />\n          </div>\n        )}\n\n        {/* TAB 6: PEER-REVIEWED CLINICAL RESEARCH HUB */}\n        {activeTab === \'research_hub\' && (\n          <div>\n            <ResearchHub />\n          </div>\n        )}\n\n        {/* Chapter Pagination Navigator (\345\210\206\351\240\201\345\277\253\351\200\237\347\277\273\351\240\201\345\210\227) */}\n        <div className=\"border-t border-stone-200/80 bg-stone-100/60 py-6\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4\">\n            {prevTab ? (\n              <button\n                type=\"button\"\n                onClick={() => handleSelectTab(prevTab.id)}\n                className=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-stone-200 text-xs sm:text-sm font-semibold text-stone-700 hover:text-stone-900 hover:bg-stone-50 transition-all shadow-2xs\"\n              >\n                <ChevronLeft className=\"w-4 h-4 text-stone-500\" />\n                <span>\344\270\212\344\270\200\347\253\240\357\274\232{prevTab.shortName}</span>\n              </button>\n            ) : (\n              <div />\n            )}\n\n            <div className=\"text-xs text-stone-500 font-mono hidden sm:block\">\n              \347\253\240\347\257\200\351\200\262\345\272\246\357\274\232{currentTabIndex + 1} / {MAIN_TABS.length}\n            </div>\n\n            {nextTab ? (\n              <button\n                type=\"button\"\n                onClick={() => handleSelectTab(nextTab.id)}\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-800 text-white text-xs sm:text-sm font-semibold hover:bg-amber-900 transition-all shadow-xs\"\n              >\n                <span>\344\270\213\344\270\200\347\253\240\357\274\232{nextTab.shortName}</span>\n                <ChevronRight className=\"w-4 h-4 text-amber-200\" />\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={() => handleSelectTab(\'home\')}\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-800 text-white text-xs sm:text-sm font-semibold hover:bg-amber-900 transition-all shadow-xs\"\n              >\n                <BookOpen className=\"w-4 h-4 text-amber-200\" />\n                <span>\350\277\224\345\233\236\351\246\226\351\240\201\350\207\252\346\270\254\345\260\216\350\256\200</span>\n              </button>\n            )}\n          </div>\n        </div>\n      </main>\n\n      {/* Footer with Medical Disclaimers & Navigation */}\n      <Footer onSelectTab={handleSelectTab} />\n    </div>\n  );\n}\n"
    num_lines: 127
    num_bytes: 5007
  }
}
