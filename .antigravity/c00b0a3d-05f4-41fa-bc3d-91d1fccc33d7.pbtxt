     </div>\\n            <div className=\\\"mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-stone-700\\\">\\n              <span>\345\255\270\347\277\222\351\201\270\350\263\274\345\277\203\346\263\225</span>\\n              <ArrowRight className=\\\"w-4 h-4 group-hover:translate-x-1 transition-transform\\\" />\\n            </div>\\n          </div>\\n\\n          {/* Card 5: Research Hub */}\\n          <div\\n            onClick={() => onNavigateTab(\'research_hub\')}\\n            className=\\\"group p-6 rounded-2xl bg-white border border-stone-200 hover:border-amber-700/50 hover:shadow-md transition-all cursor-pointer flex flex-col justify-between\\\"\\n          >\\n            <div className=\\\"space-y-3\\\">\\n              <div className=\\\"w-10 h-10 rounded-xl bg-stone-100 text-stone-800 flex items-center justify-center\\\">\\n                <Heart className=\\\"w-5 h-5 text-red-700\\\" />\\n              </div>\\n              <h3 className=\\\"font-display text-lg font-bold text-stone-900 group-hover:text-amber-800 transition-colors\\\">\\n                \345\220\214\345\204\225\345\257\251\346\237\245\347\247\221\347\240\224\346\203\205\345\240\261\345\260\210\345\215\200\\n              </h3>\\n              <p className=\\\"text-xs text-stone-600 leading-relaxed\\\">\\n                NEJM\343\200\201The Lancet\343\200\201AHA \345\277\203\350\241\200\347\256\241\346\214\207\345\274\225\350\210\207\350\241\233\347\246\217\351\203\250\345\234\213\345\201\245\347\275\262\345\244\247\345\236\213\350\207\250\345\272\212\350\251\246\351\251\227\350\210\207\345\255\270\350\241\223\345\277\253\350\250\212\343\200\202\\n              </p>\\n            </div>\\n            <div className=\\\"mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-stone-700\\\">\\n              <span>\346\237\245\351\226\261\345\234\213\351\232\233\345\257\246\350\255\211</span>\\n   