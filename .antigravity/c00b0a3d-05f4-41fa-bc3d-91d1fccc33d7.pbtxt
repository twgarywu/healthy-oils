      create_file {
        instruction: "export interface OilProfile {\n  id: string;\n  name: string;\n  englishName: string;\n  smokePointC: number;\n  smokePointF: number;\n  sfaPercent: number; // \351\243\275\345\222\214\350\204\202\350\202\252\351\205\270\n  mufaPercent: number; // \345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252\351\205\270 (Omega-9)\n  pufaPercent: number; // \345\244\232\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252\351\205\270 (Omega-3 & 6)\n  omega3Percent: number;\n  omega6Percent: number;\n  thermalStability: \'\346\245\265\344\275\216 (\345\232\264\347\246\201\345\212\240\347\206\261)\' | \'\344\270\255\347\255\211 (\344\275\216\346\272\253\346\260\264\347\202\222)\' | \'\350\211\257\345\245\275 (\344\270\200\350\210\254\347\205\216\347\202\222)\' | \'\346\245\265\351\253\230 (\351\253\230\346\272\253\345\244\247\347\201\253\346\262\271\347\202\270)\';\n  suitableCooking: (\'raw\' | \'water_fry\' | \'medium_saute\' | \'high_fry\')[];\n  cookingDescriptions: string[];\n  tasteProfile: string;\n  healthHighlights: string[];\n  caution: string;\n  storageRequirement: string;\n  isSpotlight: boolean; // \351\233\231\346\230\237\344\270\273\350\247\222\346\250\231\350\250\230\n}\n\nexport const OILS_DATABASE: OilProfile[] = [\n  {\n    id: \'flaxseed-oil\',\n    name: \'\345\206\267\345\243\223\344\272\236\351\272\273\344\273\201\346\262\271\',\n    englishName: \'Cold-Pressed Flaxseed Oil\',\n    smokePointC: 107,\n    smokePointF: 225,\n    sfaPercent: 9,\n    mufaPercent: 18,\n    pufaPercent: 73,\n    omega3Percent: 55,\n    omega6Percent: 18,\n    thermalStability: \'\346\245\265\344\275\216 (\345\232\264\347\246\201\345\212\240\347\206\261)\',\n    suitableCooking: [\'raw\'],\n    cookingDescriptions: [\'\347\224\237\351\243\262\351\244\212\347\224\237 (\346\231\250\351\226\223\347\251\272\350\205\271 10ml)\', \'\346\266\274\346\213\214\346\262\231\346\213\211\350\210\207\346\262\271\351\206\213\346\261\201\', \'\346\213\214\345\205\245\346\272\253\347\206\261\347\261\263\351\243\257\346\210\226\347\207\225\351\272\245\347\262\245 (\350\265\267\351\215\213\345\276\214)\', \'\350\252\277\351\205\215\347\262\276\345\212\233\346\271\257\350\210\207\350\224\254\346\236\234\346\230\224\'],\n    tasteProfile: \'\346\270\205\351\246\231\346\267\241\351\233\205\357\274\214\345\270\266\346\234\211\345\244\251\347\204\266\347\224\237\345\240\205\346\236\234\344\273\201\351\246\231\350\210\207\345\276\256\347\224\230\350\215\211\351\246\231\357\274\214\345\212\243\350\263\252\345\223\201\346\234\203\346\234\211\345\210\272\351\274\273\351\255\232\350\205\245\345\221\263\',\n    healthHighlights: [\n      \'\346\244\215\347\211\251\346\200\247 Omega-3 (ALA) \344\271\213\347\216\213\357\274\214\345\220\253\351\207\217\351\253\230\351\201\224 50%~60%\',\n      \'\347\264\224\347\264\240\351\243\237\350\200\205\350\243\234\345\205\205\346\212\227\347\231\274\347\202\216\350\204\202\350\202\252\351\205\270\347\232\204\346\234\200\344\275\263\351\246\226\351\201\270\',\n      \'\344\277\203\351\200\262\347\264\260\350\203\236\350\206\234\346\237\224\351\237\214\345\272\246\357\274\214\351\231\215\344\275\216\345\277\203\350\241\200\347\256\241\346\240\223\345\241\236\345\215\261\351\232\252\345\233\240\345\255\220\',\n      \'\345\257\214\345\220\253\346\234\250\351\205\232\347\264\240 (Lignans)\357\274\214\345\205\267\346\212\227\346\260\247\345\214\226\350\210\207\346\244\215\347\211\251\351\233\214\346\277\200\347\264\240\346\264\273\346\200\247\'\n    ],\n    caution: \'\347\231\274\347\205\231\351\273\236\345\203\205 107\342\204\203\357\274\214\345\217\227\347\206\261\346\245\265\346\230\223\350\277\205\351\200\237\350\201\232\345\220\210\344\275\265\347\224\237\346\210\220\346\234\211\346\257\222\350\201\232\345\220\210\347\211\251\350\210\207\345\217\215\345\274\217\350\204\202\350\202\252\357\274\233\345\232\264\347\246\201\344\273\273\344\275\225\347\206\261\347\202\222\350\210\207\346\262\271\347\202\270\343\200\202\',\n    storageRequirement: \'\345\206\267\345\243\223\345\210\235\346\246\250\343\200\201\345\205\205\346\260\256\350\243\235\345\241\253\343\200\201\346\267\261\350\211\262\351\201\277\345\205\211\347\216\273\347\222\203\347\223\266\343\200\201\351\226\213\347\223\266\345\276\214\345\277\205\351\240\210\345\206\267\350\227\217\344\270\246\346\226\274 4-6 \351\200\261\345\205\247\351\243\237\347\224\250\345\256\214\347\225\242\343\200\202\',\n    isSpotlight: true\n  },\n  {\n    id: \'camellia-oil\',\n    name: \'\345\206\267\345\243\223\350\213\246\350\214\266\346\262\271 (\350\214\266\350\212\261\347\261\275\346\262\271)\',\n    englishName: \'Extra Virgin Camellia Seed Oil\',\n    smokePointC: 252,\n    smokePointF: 485,\n    sfaPercent: 9,\n    mufaPercent: 82,\n    pufaPercent: 9,\n    omega3Percent: 1,\n    omega6Percent: 8,\n    thermalStability: \'\346\245\265\351\253\230 (\351\253\230\346\272\253\345\244\247\347\201\253\346\262\271\347\202\270)\',\n    suitableCooking: [\'raw\', \'water_fry\', \'medium_saute\', \'high_fry\'],\n    cookingDescriptions: [\'\346\231\250\351\226\223\347\224\237\351\243\262\344\277\235\350\255\267\350\203\203\351\273\217\350\206\234 (5-10ml)\', \'\345\202\263\347\265\261\350\213\246\350\214\266\346\262\271\346\213\214\351\272\265\347\267\232\350\210\207\351\233\236\346\271\257\', \'\344\270\255\345\274\217\345\244\247\347\201\253\347\210\206\351\246\231\347\205\270\350\226\221\347\211\207\', \'\351\253\230\346\272\253\347\205\216\351\255\232\343\200\201\347\202\270\347\211\251\350\210\207\347\203\230\347\204\231\346\226\231\347\220\206\'],\n    tasteProfile: \'\346\270\205\347\210\275\344\270\215\350\206\251\357\274\214\345\270\266\346\234\211\345\244\251\347\204\266\346\270\205\345\271\275\347\232\204\351\253\230\345\261\261\350\214\266\347\261\275\346\236\234\351\246\231\350\210\207\346\272\253\346\275\244\345\233\236\347\224\230\',\n    healthHighlights: [\n      \'\