1\233\236\350\265\267\351\215\213\345\211\215\346\272\253\347\206\261\346\205\242\347\205\270\', \'\346\266\274\346\213\214\350\261\206\350\205\220\350\210\207\345\260\217\351\273\203\347\223\234\', \'\351\237\223\345\274\217\346\213\214\351\243\257\350\210\207\346\262\276\351\206\254\'],\\n    tasteProfile: \'\346\277\203\347\203\210\347\204\231\347\202\222\350\212\235\351\272\273\347\204\246\351\246\231\346\260\243\346\201\257\',\\n    healthHighlights: [\\n      \'\345\257\214\345\220\253\350\212\235\351\272\273\347\264\240 (Sesamin) \350\210\207\350\212\235\351\272\273\351\205\232 (Sesamol) \345\274\267\346\225\210\346\212\227\346\260\247\345\214\226\347\211\251\',\\n      \'\345\244\251\347\204\266\346\212\227\346\260\247\345\214\226\345\244\232\351\205\232\344\275\277\346\262\271\350\204\202\346\234\254\350\272\253\344\277\235\345\255\230\346\234\237\350\274\203\351\225\267\'\\n    ],\\n    caution: \'\351\272\273\346\262\271\345\256\271\346\230\223\351\201\216\345\272\246\351\253\230\346\272\253\347\204\246\345\214\226\347\231\274\350\213\246\357\274\214\345\202\263\347\265\261\347\210\206\351\246\231\350\200\201\350\226\221\345\256\234\347\224\250\345\260\217\347\201\253\346\210\226\350\213\246\350\214\266\346\262\271\346\233\277\344\273\243\344\273\245\351\230\262\350\207\264\347\231\214\347\211\251\343\200\202\',\\n    storageRequirement: \'\345\270\270\346\272\253\351\231\260\346\266\274\350\231\225\345\257\206\351\226\211\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'canola-oil\',\\n    name: \'\344\275\216\350\212\245\351\205\270\350\217\234\347\261\275\346\262\271 (\350\212\245\350\212\261\346\262\271)\',\\n    englishName: \'Canola Oil\',\\n    smokePointC: 220,\\n    smokePointF: 428,\\n    sfaPercent: 7,\\n    mufaPercent: 63,\\n    pufaPercent: 30,\\n    omega3Percent: 9,\\n    omega6Percent: 21,\\n    thermalStability: \'\350\211\257\345\245\275 (\344\270\200\350\210\254\347\205\216\347\202\222)\',\\n    suitableCooking: [\'water_fry\', \'medium_saute\', \'high_fry\'],\\n    cookingDescriptions: [\'\346\227\245\345\270\270\345\256\266\345\272\255\345\256\266\345\270\270\347\202\222\350\217\234\', \'\351\272\265\345\214\205\350\210\207\350\233\213\347\263\225\347\203\230\347\204\231\347\203\271\350\252\277\', \'\346\267\272\345\261\244\346\262\271\347\205\216\347\202\270\'],\\n    tasteProfile: \'\346\270\205\346\267\241\347\204\241\347\211\271\346\256\212\346\260\243\345\221\263\',\\n    healthHighlights: [\\n      \'\351\243\275\345\222\214\350\204\202\350\202\252\351\205\270\346\257\224\344\276\213\346\245\265\344\275\216 (\345\203\205 7%)\',\\n      \'\345\205\274\345\205\267\351\201\251\351\207\217 Omega-3 \350\210\207\350\274\203\351\253\230 Omega-9\'\\n    ],\\n    caution: \'\345\270\202\345\224\256\345\273\211\345\203\271\345\223\201\347\211\214\345\244\232\346\216\241\347\224\250\345\214\226\345\255\270\346\255\243\345\267\261\347\203\267\351\253\230\346\272\253\346\272\266\345\212\221\350\220\203\345\217\226\350\210\207\350\204\253\350\207\255\357\274\214\345\273\272\350\255\260\351\201\270\343\200\214\347\211\251\347\220\206\345\210\235\346\246\250\345\243\223\346\246\250\346\254\276\343\200\215\343\200\202\',\\n    storageRequirement: \'\345\270\270\346\272\253\351\231\260\346\266\274\350\231\225\351\201\277\345\205\211\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'peanut-oil\',\\n    name: \'\345\202\263\347\265\261\350\212\261\347\224\237\346\262\271\',\\n    englishName: \'Peanut Oil\',\\n    smokePointC: 225,\\n    smokePointF: 437,\\n    sfaPercent: 18,\\n    mufaPercent: 48,\\n    pufaPercent: 34,\\n    omega3Percent: 0,\\n    omega6Percent: 34,\\n    thermalStability: \'\350\211\257\345\245\275 (\344\270\200\350\210\254\347\205\216\347\202\222)\',\\n    suitableCooking: [\'medium_saute\', \'high_fry\'],\\n    cookingDescriptions: [\'\344\270\255\345\274\217\351\253\230\346\272\253\347\206\261\347\202\222\', \'\351\253\230\346\272\253\351\246\231\350\204\206\346\262\271\347\202\270\346\226\231\347\220\206\', \'\350\224\245\346\262\271\351\244\205\350\210\207\347\205\216\351\244\203\347\210\206\351\246\231\'],\\n    tasteProfile: \'\346\277\203\347\203\210\351\246\231\351\206\207\347\232\204\350\212\261\347\224\237\345\240\205\346\236\234\346\273\213\345\221\263\',\\n    healthHighlights: [\\n      \'\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252\351\205\270\346\216\245\350\277\221\345\215\212\346\225\270\357\274\214\347\206\261\350\200\220\345\217\227\346\200\247\344\275\263\',\\n      \'\350\200\220\347\205\216\347\202\222\344\270\215\346\230\223\350\265\267\346\263\241\346\262\253\350\210\207\347\231\274\351\273\221\'\\n    ],\\n    caution: \'\345\277\205\351\240\210\351\201\270\350\263\274\351\200\232\351\201\216\351\273\203\351\272\264\346\257\222\347\264\240 (Aflatoxin) \345\232\264\346\240\274\346\252\242\346\270\254\344\271\213\345\220\210\346\240\274\346\262\271\345\273\240\347\224\242\345\223\201\343\200\202\',\\n    storageRequirement: \'\351\201\277\345\205\211\345\270\270\346\272\253\344\277\235\345\255\230\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'coconut-oil\',\\n    name: \'\347\211\271\347\264\232\345\210\235\346\246\250\346\244\260\345\255\220\346\262\271\',\\n    englishName: \'Virgin Coconut Oil\',\\n    smokePointC: 177,\\n    smokePointF: 350,\\n    sfaPercent: 90,\\n    mufaPercent: 7,\\n    pufaPercent: 3,\\n    omega3Percent: 0,\\n    omega6Percent: 3,\\n    thermalStability: \'\350\211\257\345\245\275 (\344\270\200\350\210\254\347\205\216\347\202\222)\',\\n    suitableCooking: [\'raw\', \'water_fry\', \'medium_saute\'],\\n    cookingDescriptions: [\'\351\230\262\345\275\210\345\222\226\345\225\241\346\224\252\346\211\223\', \'\345\215\227\346\264\213\351\242\250\345\221\263\345\222\226\345\223\251\347\207\211\347\205\256\', \'\347\224\237\351\205\256\347\203\230\347\204\231\347\263\225\351\273\236\345\217\226\344\273\243\345\245\266\346\262\271\'],\\n    tasteProfile: \'\346\277\203\351\203\201\345\244\251\347\204\266\346\244\260\351\246\231\350\210\207\345\245\266\347\224\234\351\246\231\',\\n    healthHighlights: [\\n      \'\345\220\253 60% \344\270\255\351\217\210\344\270\211\351\205\270\347\224\230\346\262\271\351\205\257 (MCT)\357\274\214\344\270\273\350\246\201\347\202\272\346\234\210\346\241\202\351\205\270 (Lauric Acid)\',\\n      \'\347\266\223\351\226\200\351\235\234\350\204\210\347\233\264\346\216\245\351\201\213\351\200\201\350\207\263\350\202\235\350\207\237\345\277\253\351\200\237\347\224\242\350\203\275\344\273\243\350\254\235\357\274\214\344\270\215\346\230\223\345\240\206\347\251\215\347\202\272\351\253\224\350\204\202\350\202\252\',\\n      \'\345\244\251\347\224\237\346\245\265\351\253\230\351\243\275\345\222\214\345\272\246\357\274\214\344\270\215\346\230\223\350\242\253\350\207\252\347\224\261\345\237\272\346\260\247\345\214\226\'\\n    ],\\n    caution: \'\351\233\226\347\204\266\351\253\230\351\243\275\345\222\214\344\275\206\346\234\252\347\262\276\347\205\211\346\254\276\347\231\274\347\205\231\351\273\236\345\203\205 177\342\204\203\357\274\214\344\270\224\345\244\247\351\207\217\346\224\235\345\217\226\344\273\215\346\234\203\346\217\220\351\253\230\351\203\250\345\210\206\346\227\217\347\276\244\344\271\213 ApoB \350\210\207 LDL \346\214\207\346\250\231\343\200\202\',\\n    storageRequirement: \'\344\275\216\346\226\274 24\342\204\203 \346\234\203\345\207\235\345\233\272\347\202\272\344\271\263\347\231\275\345\233\272\346\205\213\345\261\254\346\255\243\345\270\270\347\211\251\347\220\206\347\217\276\350\261\241\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'soybean-oil\',\\n    name: \'\347\262\276\347\205\211\345\244\247\350\261\206\346\262\231\346\213\211\346\262\271\',\\n    englishName: \'Refined Soybean Oil\',\\n    smokePointC: 232,\\n    smokePointF: 450,\\n    sfaPercent: 15,\\n    mufaPercent: 23,\\n    pufaPercent: 62,\\n    omega3Percent: 7,\\n    omega6Percent: 55,\\n    thermalStability: \'\344\270\255\347\255\211 (\344\275\216\346\272\253\346\260\264\347\202\222)\',\\n    suitableCooking: [\'water_fry\', \'medium_saute\'],\\n    cookingDescriptions: [\'\351\244\220\351\243\262\345\244\226\351\243\237\351\200\232\347\224\250\345\237\272\345\272\225\346\262\271\', \'\344\270\200\350\210\254\344\275\216\346\272\253\347\202\222\350\217\234\'],\\n    tasteProfile: \'\344\270\255\346\200\247\347\204\241\345\221\263\',\\n    healthHighlights: [\'\345\217\226\345\276\227\346\210\220\346\234\254\344\275\216\357\274\214\345\257\214\345\220\253\347\266\255\347\224\237\347\264\240 E\'],\\n    caution: \'Omega-6 \344\275\224\346\257\224\350\266\205\351\201\216 50%\357\274\214\351\225\267\346\234\237\351\201\216\351\207\217\346\230\257\345\260\216\350\207\264\347\217\276\344\273\243\344\272\272\346\205\242\346\200\247\347\231\274\347\202\216\350\210\207\345\277\203\350\241\200\347\256\241\350\262\240\346\223\224\347\232\204\351\232\261\345\275\242\345\205\203\345\207\266\357\274\233\344\270\224\345\244\232\347\202\272\345\214\226\345\255\270\346\272\266\345\212\221\346\265\270\345\207\272\347\262\276\347\205\211\343\200\202\',\\n    storageRequirement: \'\345\257\206\345\260\201\351\231\260\346\266\274\350\231\225\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'sunflower-oil\',\\n    name: \'\345\202\263\347\265\261\350\221\265\350\212\261\347\261\275\346\262\271\',\\n    englishName: \'Standard Sunflower Oil\',\\n    smokePointC: 227,\\n    smokePointF: 440,\\n    sfaPercent: 11,\\n    mufaPercent: 20,\\n    pufaPercent: 69,\\n    omega3Percent: 1,\\n    omega6Percent: 68,\\n    thermalStability: \'\344\270\255\347\255\211 (\344\275\216\346\272\253\346\260\264\347\202\222)\',\\n    suitableCooking: [\'water_fry\', \'medium_saute\'],\\n    cookingDescriptions: [\'\350\245\277\351\273\236\347\203\230\347\204\231\', \'\344\270\255\346\272\253\345\256\266\345\272\255\347\205\216\347\202\222\'],\\n    tasteProfile: \'\346\270\205\346\267\241\347\204\241\347\211\271\346\256\212\346\260\243\345\221\263\',\\n    healthHighlights: [\'\345\244\251\347\204\266\347\266\255\347\224\237\347\264\240 E (\316\261-\347\224\237\350\202\262\351\205\232) \345\220\253\351\207\217\350\261\220\345\257\214\'],\\n    caution: \'\345\202\263\347\265\261\350\221\265\350\212\261\346\262\271 Omega-6 \346\257\224\344\276\213\346\245\265\351\253\230 (\350\277\221 70%)\357\274\214\345\217\215\350\246\206\345\212\240\347\206\261\346\245\265\346\230\223\350\243\202\350\247\243\345\207\272\346\260\247\345\214\226\350\206\275\345\233\272\351\206\207\350\210\207\351\201\216\346\260\247\345\214\226\350\204\202\350\263\252\343\200\202\',\\n    storageRequirement: \'\351\231\260\346\266\274\350\231\225\351\201\277\345\205\211\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'ghee\',\\n    name: \'\350\215\211\351\243\274\347\204\241\346\260\264\345\245\266\346\262\271 (Ghee)\',\\n    englishName: \'Grass-Fed Clarified Butter (Ghee)\',\\n    smokePointC: 250,\\n    smokePointF: 482,\\n    sfaPercent: 65,\\n    mufaPercent: 30,\\n    pufaPercent: 5,\\n    omega3Percent: 1,\\n    omega6Percent: 4,\\n    thermalStability: \'\346\245\265\351\253\230 (\351\253\230\346\272\253\345\244\247\347\201\253\346\262\271\347\202\270)\',\\n    suitableCooking: [\'medium_saute\', \'high_fry\'],\\n    cookingDescriptions: [\'\351\253\230\346\272\253\347\205\216\347\211\233\346\216\222\350\210\207\351\246\231\347\205\216\347\276\212\346\216\222\', \'\345\215\260\345\272\246\351\246\231\346\226\231\346\226\231\347\220\206\', \'\347\203\230\347\203\244\347\204\246\345\214\226\351\246\231\346\260\243\'],\\n    tasteProfile: \'\346\277\203\351\203\201\345\244\252\345\246\203\347\263\226\350\210\207\345\240\205\346\236\234\347\204\246\345\214\226\345\245\266\351\246\231\',\\n    healthHighlights: [\\n      \'\345\216\273\351\231\244\351\205\252\350\233\213\347\231\275\350\210\207\344\271\263\347\263\226\357\274\214\344\271\263\347\263\226\344\270\215\350\200\220\350\200\205\345\217\257\345\256\211\345\277\203\344\272\253\347\224\250\',\\n      \'\345\257\214\345\220\253\345\205\261\350\273\233\344\272\236\351\272\273\346\262\271\351\205\270 (CLA) \350\210\207\347\237\255\351\217\210\344\270\201\351\205\270 (Butyrate)\357\274\214\345\256\210\350\255\267\350\205\270\351\201\223\345\261\217\351\232\234\',\\n      \'\351\253\230\346\272\253\346\245\265\347\253\257\347\251\251\345\256\232\344\270\215\346\230\223\350\256\212\350\263\252\'\\n    ],\\n    caution: \'\351\243\275\345\222\214\350\204\202\350\202\252\346\257\224\344\276\213\350\274\203\351\253\230\357\274\214\345\277\203\350\241\200\347\256\241\351\253\230\350\241\200\350\204\202\346\202\243\350\200\205\345\256\234\347\270\275\351\207\217\346\216\247\347\256\241\343\200\202\',\\n    storageRequirement: \'\345\270\270\346\272\253\351\201\277\345\205\211\351\201\277\346\277\225\357\274\214\351\201\277\345\205\215\344\271\276\346\267\250\346\271\257\345\214\231\345\217\227\346\275\256\343\200\202\',\\n    isSpotlight: false\\n  },\\n  {\\n    id: \'lard\',\\n    name: \'\347\264\224\351\273\221\350\261\254\350\261\254\346\262\271 (\345\202\263\347\265\261\345\217\244\346\263\225\350\207\252\346\246\250)\',\\n    englishName: \'Traditional Lard\',\\n    smokePointC: 190,\\n    smokePointF: 374,\\n    sfaPercent: 40,\\n    mufaPercent: 48,\\n    pufaPercent: 12,\\n    omega3Percent: 1,\\n    omega6Percent: 11,\\n    thermalStability: \'\350\211\257\345\245\275 (\344\270\200\350\210\254\347\205\216\347\202\222)\',\\n    suitableCooking: [\'medium_saute\', \'high_fry\'],\\n    cookingDescriptions: [\'\345\202\263\347\265\261\344\270\255\345\274\217\351\205\245\347\232\256\351\273\236\345\277\203\', \'\350\261\254\346\262\271\346\213\214\351\243\257\', \'\347\210\206\347\202\222\351\235\222\346\261\237\350\217\234\'],\\n    tasteProfile: \'\346\277\203\351\206\207\350\202\211\351\246\231\350\210\207\345\202\263\347\265\261\346\207\267\350\210\212\351\221\212\346\260\243\',\\n    healthHighlights: [\\n      \'\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252 (\346\262\271\351\205\270) \344\275\224\346\257\224\350\277\221 50%\357\274\214\351\253\230\346\226\274\344\270\200\350\210\254\345\210\273\346\235\277\345\215\260\350\261\241\',\\n      \'\350\200\220\347\205\216\347\202\222\357\274\214\344\270\215\345\220\253\346\260\253\345\214\226\346\244\215\347\211\251\346\262\271\344\271\213\344\272\272\345\267\245\345\217\215\345\274\217\350\204\202\350\202\252\351\205\270\'\\n    ],\\n    caution: \'\345\220\253\350\206\275\345\233\272\351\206\207\350\210\207\350\274\203\351\253\230\351\243\275\345\222\214\350\204\202\350\202\252\357\274\214\347\217\276\344\273\243\351\201\213\345\213\225\351\207\217\344\270\215\350\266\263\344\271\213\346\227\217\347\276\244\344\270\215\345\256\234\351\244\220\351\244\220\346\224\235\345\217\226\343\200\202\',\\n    storageRequirement: \'\345\257\206\345\260\201\345\206\267\350\227\217\344\277\235\345\255\230\343\200\202\',\\n    isSpotlight: false\\n  }\\n];\\n\\nexport interface CookingTechnique {\\n  id: \'raw\' | \'water_fry\' | \'medium_saute\' | \'high_fry\';\\n  label: string;\\n  nameZh: string;\\n  tempRange: string;\\n  maxSafeTempC: number;\\n  description: string;\\n  exampleDishes: string;\\n  recommendedOilIds: string[];\\n}\\n\\nexport const COOKING_TECHNIQUES: CookingTechnique[] = [\\n  {\\n    id: \'raw\',\\n    label: \'\347\224\237\351\243\262 / \346\266\274\346\213\214 / \350\265\267\351\215\213\345\276\214\346\267\213\351\206\254\',\\n    nameZh: \'\345\206\267\346\213\214\347\224\237\351\243\262\',\\n    tempRange: \'\345\270\270\346\272\253 ~ 45\342\204\203\',\\n    maxSafeTempC: 45,\\n    description: \'\345\256\214\345\205\250\344\270\215\345\212\240\347\206\261\357\274\214\345\256\214\346\225\264\344\277\235\347\225\231 100% \347\206\261\346\225\217\346\200\247\346\264\273\346\200\247\345\244\232\351\205\232\343\200\201\346\234\250\351\205\232\347\264\240\343\200\201\350\247\222\351\257\212\347\203\257\350\210\207\350\204\206\345\274\261\347\232\204 Omega-3 \350\204\202\350\202\252\351\205\270\343\200\202\',\\n    exampleDishes: \'\346\231\250\351\226\223\347\251\272\350\205\271\347\224\237\351\243\262\351\244\212\347\224\237\343\200\201\346\262\271\351\206\213\347\224\237\350\217\234\346\262\231\346\213\211\343\200\201\347\262\276\345\212\233\346\271\257\346\236\234\346\230\224\343\200\201\347\205\256\345\245\275\344\271\213\351\243\257\351\272\265\350\265\267\351\215\213\346\267\213\346\262\271\',\\n    recommendedOilIds: [\'flaxseed-oil\', \'camellia-oil\', \'evoo\', \'perilla-oil\', \'walnut-oil\']\\n  },\\n  {\\n    id: \'water_fry\',\\n    label: \'\344\275\216\346\272\253\346\260\264\347\202\222 / \346\272\253\347\201\253\347\207\211\347\205\256\',\\n    nameZh: \'\346\260\264\347\202\222\347\207\211\347\205\256\',\\n    tempRange: \'100\342\204\203 ~ 130\342\204\203\',\\n    maxSafeTempC: 130,\\n    description: \'\345\205\210\346\226\274\351\215\213\344\270\255\345\212\240\345\205\245\345\260\221\350\250\261\346\260\264\346\210\226\351\253\230\346\271\257\357\274\214\345\206\215\345\200\222\345\205\245\346\262\271\345\212\240\347\206\261\357\274\210\346\260\264\346\262\270\351\273\236 100\342\204\203 \345\275\242\346\210\220\345\244\251\347\204\266\346\216\247\346\272\253\345\261\217\351\232\234\357\274\211\357\274\214\345\244\247\345\271\205\351\231\215\344\275\216\346\262\271\347\205\231\347\224\242\347\224\237\343\200\202\',\\n    exampleDishes: \'\346\260\264\347\202\222\346\231\202\344\273\244\351\235\222\350\217\234\343\200\201\346\272\253\347\201\253\347\207\211\346\271\257\343\200\201\346\264\213\350\224\245\344\275\216\346\272\253\346\205\242\347\202\222\350\207\263\351\200\217\346\230\216\343\200\201\346\270\205\350\222\270\351\255\232\346\267\213\346\262\271\',\\n    recommendedOilIds: [\'camellia-oil\', \'evoo\', \'avocado-oil\', \'canola-oil\', \'sesame-oil\']\\n  },\\n  {\\n    id: \'medium_saute\',\\n    label: \'\344\270\255\346\272\253\345\277\253\347\202\222 / \351\246\231\347\205\216\',\\n    nameZh: \'\347\206\261\347\202\222\351\246\231\347\205\216\',\\n    tempRange: \'140\342\204\203 ~ 180\342\204\203\',\\n    maxSafeTempC: 180,\\n    description: \'\344\270\200\350\210\254\345\256\266\345\272\255\345\270\270\350\246\213\347\206\261\351\215\213\347\203\271\350\252\277\357\274\214\351\215\213\345\205\247\346\272\253\345\272\246\345\244\232\350\220\275\345\234\250 160-180\342\204\203\343\200\202\346\262\271\345\223\201\347\231\274\347\205\231\351\273\236\350\207\263\345\260\221\351\234\200\351\253\230\346\226\274 190\342\204\203 \346\226\271\350\203\275\347\242\272\344\277\235\345\256\211\345\205\250\347\204\241\350\207\264\347\231\214\346\262\271\347\205\231\343\200\202\',\\n    exampleDishes: \'\345\256\266\345\270\270\350\202\211\347\265\262\347\202\222\350\217\234\343\200\201\351\246\231\347\205\216\350\261\206\350\205\220\343\200\201\350\215\267\345\214\205\350\233\213\343\200\201\350\222\234\350\223\211\347\202\222\350\235\246\',\\n    recommendedOilIds: [\'camellia-oil\', \'avocado-oil\', \'canola-oil\', \'peanut-oil\', \'ghee\']\\n  },\\n  {\\n    id: \'high_fry\',\\n    label: \'\351\253\230\346\272\253\345\244\247\347\201\253\347\210\206\347\202\222 / \346\262\271\347\202\270\347\203\230\347\203\244\',\\n    nameZh: \'\345\244\247\347\201\253\351\253\230\346\272\253\347\205\216\347\202\270\',\\n    tempRange: \'190\342\204\203 ~ 230\342\204\203+\',\\n    maxSafeTempC: 240,\\n    description: \'\345\244\247\347\201\253\347\205\270\351\246\231\343\200\201\351\205\245\350\204\206\346\267\261\345\261\244\346\262\271\347\202\270\346\210\226\351\253\230\346\272\253\347\203\244\347\256\261\347\203\230\347\203\244\343\200\202\347\231\274\347\205\231\351\273\236\345\277\205\351\240\210\351\201\224\345\210\260 220\342\204\203~250\342\204\203 \344\273\245\344\270\212\357\274\214\344\270\224\350\204\202\350\202\252\351\205\270\345\277\205\351\240\210\345\205\267\345\202\231\351\253\230\346\212\227\346\260\247\345\214\226\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\347\211\271\346\200\247\343\200\202\',\\n    exampleDishes: \'\351\253\230\346\272\253\351\246\231\347\205\216\345\216\232\345\210\207\347\211\233\346\216\222\343\200\201\344\270\255\345\274\217\345\244\247\347\201\253\347\205\270\350\200\201\350\226\221\343\200\201\347\202\270\351\233\236\345\241\212\347\202\270\345\244\251\345\251\246\347\276\205\343\200\201\347\203\230\347\203\244\351\253\230\346\272\253\350\202\211\346\216\222\',\\n    recommendedOilIds: [\'camellia-oil\', \'avocado-oil\', \'ghee\', \'peanut-oil\']\\n  }\\n];\\n\",\"Description\":\"Create detailed 14-oil nutritional dataset, smoke points, and cooking techniques\",\"Overwrite\":true,\"TargetFile\":\"/src/data/oilData.ts\",\"toolAction\":\"Writing oil database\",\"toolSummary\":\"Create src/data/oilData.ts dataset\"}"
