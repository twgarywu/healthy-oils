        instruction: "import React, { useState } from \'react\';\nimport { Droplets, ShieldAlert, Sparkles, CheckCircle, Flame, Heart, Utensils, AlertTriangle, Snowflake } from \'lucide-react\';\n\nexport const DualStarSpotlight: React.FC = () => {\n  const [activeStarTab, setActiveStarTab] = useState<\'both\' | \'flax\' | \'camellia\'>(\'both\');\n\n  return (\n    <section id=\"dual-stars\" className=\"py-16 md:py-24 bg-white border-b border-stone-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Section Header */}\n        <div className=\"max-w-3xl mb-12\">\n          <div className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-amber-800 mb-2\">\n            <span>\346\250\241\347\265\204 03</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\346\240\270\345\277\203\347\204\246\351\273\236\345\211\226\346\236\220</span>\n          </div>\n          <h2 className=\"font-display text-2xl sm:text-3xl md:text-4xl font-bold text-stone-900 tracking-tight leading-snug [text-wrap:balance]\">\n            \351\233\231\346\230\237\344\270\273\350\247\222\346\267\261\345\272\246\350\201\232\347\204\246\357\274\232\344\272\236\351\272\273\344\273\201\346\262\271\350\210\207\350\213\246\350\214\266\346\262\271\n          </h2>\n          <p className=\"mt-3 text-stone-600 text-base leading-relaxed\">\n            \344\270\200\345\200\213\346\230\257\346\212\227\347\231\274\347\202\216\345\206\267\346\213\214\347\232\204\343\200\214\346\244\215\347\211\251\346\200\247 Omega-3 \344\271\213\347\216\213\343\200\215\357\274\214\344\270\200\345\200\213\346\230\257\350\200\220\351\253\230\346\272\253\350\255\267\350\203\203\347\232\204\343\200\214\346\235\261\346\226\271\346\266\262\351\253\224\351\273\203\351\207\221\343\200\215\343\200\202\n            \345\205\251\350\200\205\344\272\222\350\243\234\345\205\261\345\255\230\357\274\214\345\256\214\347\276\216\346\266\265\350\223\213\345\256\266\345\272\255\345\273\232\346\210\277\345\276\236\346\231\250\351\226\223\347\224\237\351\243\262\343\200\201\346\266\274\346\213\214\345\206\267\347\233\244\345\210\260\347\206\261\351\215\213\345\244\247\347\201\253\347\205\216\347\202\222\347\232\204\345\205\250\346\226\271\344\275\215\351\234\200\346\261\202\343\200\202\n          </p>\n        </div>\n\n        {/* View Filter Switch */}\n        <div className=\"flex items-center gap-1.5 p-1 bg-stone-100 rounded-lg max-w-sm mb-10 border border-stone-200\">\n          <button\n            onClick={() => setActiveStarTab(\'both\')}\n            className={`flex-1 py-1.5 px-3 text-xs font-medium rounded-md transition-all ${\n              activeStarTab === \'both\' ? \'bg-white text-stone-900 shadow-xs\' : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            \351\233\231\346\230\237\344\270\246\350\241\214\345\260\215\347\205\247\n          </button>\n          <button\n            onClick={() => setActiveStarTab(\'flax\')}\n            className={`flex-1 py-1.5 px-3 text-xs font-medium rounded-md transition-all ${\n              activeStarTab === \'flax\' ? \'bg-white text-stone-900 shadow-xs\' : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            \344\272\236\351\272\273\344\273\201\346\262\271\345\260\210\351\241\214\n          </button>\n          <button\n            onClick={() => setActiveStarTab(\'camellia\')}\n            className={`flex-1 py-1.5 px-3 text-xs font-medium rounded-md transition-all ${\n              activeStarTab === \'camellia\' ? \'bg-white text-stone-900 shadow-xs\' : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            \350\213\246\350\214\266\346\262\271\345\260\210\351\241\214\n          </button>\n        </div>\n\n        {/* Dual Star Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10\">\n          {/* STAR 1: FLAXSEED OIL */}\n          {(activeStarTab === \'both\' || activeStarTab === \'flax\') && (\n            <div className=\"bg-[#FAF8F5] border border-amber-900/20 rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-xs hover:border-amber-900/40 transition-all\">\n              <div className=\"space-y-6\">\n                {/* Header Tag */}\n                <div className=\"flex items-start justify-between gap-4\">\n                  <div>\n                    <div className=\"text-xs uppercase tracking-wider font-semibold text-amber-800 font-sans mb-1\">\n                      Omega-3 \344\271\213\347\216\213 \302\267 \346\244\215\347\211\251\346\212\227\347\231\274\347\202\216\345\206\240\350\273\215\n                    </div>\n                    <h3 className=\"font-display text-2xl sm:text-3xl font-bold text-stone-900\">\n                      \345\206\267\345\243\223\344\272\236\351\272\273\344\273\201\346\262\271\n                    </h3>\n                    <p className=\"text-xs text-stone-500 font-sans mt-0.5\">\n                      Flaxseed Oil (Linum usitatissimum)\n                    </p>\n                  </div>\n                  <div className=\"w-12 h-12 rounded-xl bg-amber-800 text-white flex items-center justify-center font-display text-lg font-bold shadow-xs shrink-0\">\n                    ALA\n                  </div>\n                </div>\n\n                {/* Key Metrics Strip */}\n                <div className=\"grid grid-cols-3 gap-3 p-3.5 bg-white rounded-xl border border-stone-200 text-center\">\n                  <div>\n                    <span className=\"text-[11px] text-stone-500 block\">\316\261-\344\272\236\351\272\273\351\205\270 (ALA)</span>\n                    <span className=\"font-mono text-base font-bold text-amber-900 tabular-nums\">\n                      55% ~ 60%\n                    </span>\n                  </div>\n                  <div className=\"border-x border-stone-100\">\n                    <span className=\"text-[11px] text-stone-500 block\">\347\231\274\347\205\231\351\273\236 (\346\245\265\344\275\216)</span>\n                    <span className=\"font-mono text-base font-bold text-red-700 tabular-nums\">\n                      107\342\204\203\n                    </span>\n                  </div>\n                  <div>\n                    <span className=\"text-[11px] text-stone-500 block\">\346\257\217\346\227\245\345\273\272\350\255\260\351\207\217</span>\n                    <span className=\"font-mono text-base font-bold text-stone-900 tabular-nums\">\n                      10 ~ 15 ml\n                    </span>\n                  </div>\n                </div>\n\n                {/* Biochemical Role & Vegetarian Benefits */}\n                <div className=\"space-y-3\">\n                  <h4 className=\"text-xs uppercase tracking-wider font-semibold text-stone-500 font-sans\">\n                    \347\224\237\345\214\226\346\251\237\345\210\266\350\210\207\347\264\240\351\243\237\346\212\227\347\231\274\347\202\216\345\203\271\345\200\274\n                  </h4>\n                  <p className=\"text-sm text-stone-700 leading-relaxed\">\n                    \344\272\236\351\272\273\344\273\201\346\262\271\346\230\257\351\231\270\345\234\260\344\270\212 \316\261-\344\272\236\351\272\273\351\205\270\357\274\210ALA\357\274\211\346\277\203\345\272\246\346\234\200\351\253\230\347\232\204\345\244\251\347\204\266\346\244\215\347\211\251\346\262\271\344\271\213\344\270\200\343\200\202\n                    \345\234\250\344\272\272\351\253\224\345\205\247\357\274\214ALA \347\266\223\347\242\263\351\217\210\345\273\266\351\225\267\350\210\207\345\216\273\351\243\275\345\222\214\351\205\265\347\264\240\350\275\211\345\214\226\347\202\272 EPA \350\210\207 DHA\357\274\214\344\270\246\345\220\210\346\210\220\346\212\227\347\231\274\347\202\216\345\211\215\345\210\227\350\205\272\347\264\240\357\274\210PGE3\357\274\211\350\210\207\346\266\210\351\200\200\347\264\240\357\274\210Resolvins\357\274\211\343\200\202\n                    \345\260\215\346\226\274\344\270\215\345\220\203\351\255\232\346\262\271\347\232\204\347\264\224\347\264\240\350\200\205\343\200\201\346\265\267\351\256\256\351\201\216\346\225\217\350\200\205\357\274\214\344\272\236\351\272\273\344\273\201\346\262\271\346\230\257\347\257\211\350\265\267\351\253\224\345\205\247\346\212\227\347\231\274\347\202\216\345\261\217\351\232\234\346\234\200\344\270\215\345\217\257\346\210\226\347\274\272\347\232\204\345\237\272\347\237\263\343\200\202\n                  </p>\n                  <p className=\"text-sm text-stone-700 leading-relaxed\">\n                    \346\255\244\345\244\226\357\274\214\345\206\267\345\243\223\344\272\236\351\272\273\344\273\201\346\262\271\345\257\214\345\220\253\343\200\214\346\234\250\351\205\232\347\264\240\357\274\210Lignans\357\274\211\343\200\215\357\274\214\347\202\272\345\244\251\347\204\266\345\274\267\345\212\233\345\244\232\351\205\232\350\210\207\346\244\215\347\211\251\346\200\247\351\233\214\346\277\200\347\264\240\346\212\227\346\260\247\345\214\226\347\211\251\357\274\214\346\234\211\345\212\251\350\252\277\347\257\200\345\245\263\346\200\247\347\224\237\347\220\206\346\251\237\350\203\275\344\270\246\347\266\255\346\214\201\345\277\203\350\241\200\347\256\241\345\276\256\345\276\252\347\222\260\351\200\232\346\232\242\343\200\202\n                  </p>\n                </div>\n\n                {/* Usage Rules & Strict Cautions */}\n                <div className=\"p-4 rounded-xl bg-red-50/70 border border-red-200/80 space-y-2 text-xs sm:text-sm text-stone-800\">\n                  <div className=\"flex items-center gap-2 text-red-900 font-bold\">\n                    <ShieldAlert className=\"w-4 h-4 text-red-700 shrink-0\" />\n                    <span>\344\270\211\345\244\247\344\277\235\345\255\230\345\256\210\345\211\207\350\210\207\345\212\240\347\206\261\347\246\201\345\277\214</span>\n                  </div>\n                  <ul className=\"space-y-1.5 text-xs text-stone-700\">\n                    <li className=\"flex items-start gap-2\">\n                      <span className=\"font-bold text-red-700 shrink-0\">1. \345\232\264\347\246\201\344\273\273\344\275\225\347\206\261\351\215\213\347\203\271\350\252\277\357\274\232</span>\n                      <span>\347\231\274\347\205\231\351\273\236\345\203\205 107\342\204\203\357\274\214\345\212\240\347\206\261\346\245\265\346\230\223\350\201\232\345\220\210\347\224\242\347\224\237\345\217\215\345\274\217\350\204\202\350\202\252\350\210\207\351\201\216\346\260\247\345\214\226\350\207\252\347\224\261\345\237\272\343\200\202</span>\n                    </li>\n                    <li className=\"flex items-start gap-2\">\n                      <span className=\"font-bold text-red-700 shrink-0\">2. \351\226\213\347\223\266\345\277\205\351\240\210\345\206\267\350\227\217\357\274\232</span>\n                      <span>\345\255\230\346\224\276\346\226\274 4\342\204\203~8\342\204\203 \345\206\260\347\256\261\345\206\267\350\227\217\345\256\244\357\274\214\351\201\277\345\205\215\345\270\270\346\272\253\346\260\247\345\214\226\350\256\212\350\263\252\347\224\242\347\224\237\351\255\232\350\205\245\345\221\263\343\200\202</span>\n                    </li>\n                    <li className=\"flex items-start gap-2\">\n                      <span className=\"font-bold text-red-700 shrink-0\">3. 4-6 \351\200\261\345\205\247\347\233\241\351\200\237\347\224\250\347\225\242\357\274\232</span>\n                      <span>\346\216\241\350\262\267\345\273\272\350\255\260\351\201\270\346\223\207 250ml \345\260\217\347\223\266\350\243\235\357\274\214\351\226\213\347\223\266\345\276\214\344\270\200\345\200\213\345\215\212\346\234\210\345\205\247\351\243\237\347\224\250\345\256\214\347\225\242\346\234\200\347\202\272\346\226\260\351\256\256\343\200\202</span>\n                    </li>\n                  </ul>\n                </div>\n\n                {/* Culinary Recipe Pairing */}\n                <div className=\"p-4 rounded-xl bg-white border border-stone-200 space-y-1.5 text-xs\">\n                  <div className=\"flex items-center gap-1.5 font-semibold text-stone-900\">\n                    <Utensils className=\"w-3.5 h-3.5 text-amber-800\" />\n                    <span>\346\227\245\345\270\270\347\207\237\351\244\212\345\270\253\346\216\250\350\226\246\351\243\237\350\255\234\357\274\232\351\231\275\345\205\211\346\264\273\345\212\233\346\272\253\347\207\225\351\272\245\345\204\252\346\240\274\347\242\227</span>\n                  </div>\n                  <p className=\"text-stone-600 leading-relaxed\">\n                    \347\205\256\345\245\275\346\272\253\347\206\261\347\232\204\347\204\241\347\263\226\347\207\225\351\272\245\347\262\245\346\210\226\345\270\214\350\207\230\345\204\252\346\240\274\347\233\233\347\242\227\357\274\214<strong className=\"text-stone-900 font-medium\">\350\265\267\351\215\213\347\250\215\351\231\215\346\272\253\345\276\214</strong>\357\274\214\346\267\213\345\205\245 1 \346\271\257\345\214\231\345\206\267\345\243\223\344\272\236\351\272\273\344\273\201\346\262\271\357\274\214\346\222\222\344\270\212\350\227\215\350\216\223\350\210\207\346\240\270\346\241\203\347\242\216\343\200\202\345\240\205\346\236\234\351\246\231\346\260\243\350\236\215\346\226\274\347\207\225\351\272\245\357\274\214\346\227\242\344\270\215\347\240\264\345\243\236\345\245\275\346\262\271\346\264\273\346\200\247\357\274\214\346\233\264\350\203\275\345\220\270\346\224\266\350\204\202\346\272\266\346\200\247\347\266\255\347\224\237\347\264\240\343\200\202\n                  </p>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* STAR 2: CAMELLIA SEED OIL */}\n          {(activeStarTab === \'both\' || activeStarTab === \'camellia\') && (\n            <div className=\"bg-[#FAF8F5] border border-emerald-900/20 rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-xs hover:border-emerald-900/40 transition-all\">\n              <div className=\"space-y-6\">\n                {/* Header Tag */}\n                <div className=\"flex items-start justify-between gap-4\">\n                  <div>\n                    <div className=\"text-xs uppercase tracking-wider font-semibold text-emerald-800 font-sans mb-1\">\n                      \346\235\261\346\226\271\346\251\204\346\254\226\346\262\271 \302\267 \351\253\230\346\272\253\350\255\267\350\203\203\345\205\250\350\203\275\347\245\236\346\262\271\n                    </div>\n                    <h3 className=\"font-display text-2xl sm:text-3xl font-bold text-stone-900\">\n                      \345\206\267\345\243\223\350\213\246\350\214\266\346\262\271 (\350\214\266\350\212\261\347\261\275\346\262\271)\n                    </h3>\n                    <p className=\"text-xs text-stone-500 font-sans mt-0.5\">\n                      Camellia Seed Oil (Camellia oleifera)\n                    </p>\n                  </div>\n                  <div className=\"w-12 h-12 rounded-xl bg-emerald-800 text-white flex items-center justify-center font-display text-lg font-bold shadow-xs shrink-0\">\n                    \316\2519\n                  </div>\n                </div>\n\n                {/* Key Metrics Strip */}\n                <div className=\"grid grid-cols-3 gap-3 p-3.5 bg-white rounded-xl border border-stone-200 text-center\">\n                  <div>\n                    <span className=\"text-[11px] text-stone-500 block\">\345\226\256\345\205\203\346\262\271\351\205\270 (MUFA)</span>\n                    <span className=\"font-mono text-base font-bold text-emerald-900 tabular-nums\">\n                      80% ~ 83%\n                    </span>\n                  </div>\n                  <div className=\"border-x border-stone-100\">\n                    <span className=\"text-[11px] text-stone-500 block\">\347\231\274\347\205\231\351\273\236 (\346\245\265\350\200\220\346\272\253)</span>\n                    <span className=\"font-mono text-base font-bold text-emerald-800 tabular-nums\">\n                      252\342\204\203\n                    </span>\n                  </div>\n                  <div>\n                    <span className=\"text-[11px] text-stone-500 block\">\346\212\227\350\203\203\351\273\217\350\206\234\344\277\256\345\276\251</span>\n                    <span className=\"font-mono text-base font-bold text-stone-900 tabular-nums\">\n                      \350\214\266\345\244\232\351\205\232+\350\247\222\351\257\212\347\203\257\n                    </span>\n                  </div>\n                </div>\n\n                {/* Biochemical Role & Gastrointestinal Benefits */}\n                <div className=\"space-y-3\">\n                  <h4 className=\"text-xs uppercase tracking-wider font-semibold text-stone-500 font-sans\">\n                    \347\224\237\345\214\226\346\251\237\345\210\266\350\210\207\346\235\261\346\226\271\351\244\212\347\224\237\350\255\267\350\203\203\347\233\212\350\231\225\n                  </h4>\n                  <p className=\"text-sm text-stone-700 leading-relaxed\">\n                    \350\213\246\350\214\266\346\262\271\346\217\220\347\205\211\350\207\252\351\253\230\345\261\261\346\262\271\350\214\266\346\250\271\347\250\256\347\261\275\357\274\214\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\350\204\202\350\202\252\351\205\270\357\274\210\346\262\271\351\205\270 Oleic Acid\357\274\211\345\220\253\351\207\217\351\253\230\351\201\224 82% \344\273\245\344\270\212\357\274\214\347\264\224\345\272\246\347\224\232\350\207\263\350\266\205\350\266\212\345\234\260\344\270\255\346\265\267\347\211\271\347\264\232\345\210\235\346\246\250\346\251\204\346\254\226\346\262\271\343\200\202\n                    \351\253\230\345\226\256\345\205\203\344\270\215\351\243\275\345\222\214\347\265\220\346\247\213\350\203\275\351\231\215\344\275\216\345\243\236\350\206\275\345\233\272\351\206\207\357\274\210LDL-C\357\274\211\344\270\246\344\277\235\347\225\231\345\245\275\350\206\275\345\233\272\351\206\207\357\274\210HDL-C\357\274\211\357\274\214\345\256\210\350\255\267\345\277\203\350\241\200\347\256\241\345\205\247\347\232\256\347\264\260\350\203\236\345\275\210\346\200\247\343\200\202\n                  </p>\n                  <p className=\"text-sm text-stone-700 leading-relaxed\">\n                    \350\213\246\350\214\266\346\262\271\345\244\251\347\204\266\350\230\212\345\220\253\350\261\220\345\257\214\347\232\204<strong className=\"text-stone-900 font-medium\">\350\214\266\345\244\232\351\205\232\343\200\201\350\221\211\347\266\240\347\264\240\343\200\201\350\247\222\351\257\212\347\203\257\357\274\210Squalene\357\274\211\350\210\207\345\261\261\350\214\266\350\213\267</strong>\343\200\202\347\217\276\344\273\243\351\206\253\345\255\270\345\257\246\351\251\227\350\255\211\345\257\246\357\274\214\345\205\266\345\244\232\351\205\232\346\210\220\345\210\206\350\203\275\345\242\236\345\212\240\350\203\203\351\273\217\350\206\234\345\261\217\351\232\234\344\277\235\350\255\267\345\261\244\345\211\215\345\210\227\350\205\272\347\264\240\345\210\206\346\263\214\357\274\214\345\260\215\346\224\271\345\226\204\350\203\203\346\275\260\347\230\215\343\200\201\347\267\251\350\247\243\350\203\203\351\243\237\351\201\223\351\200\206\346\265\201\344\270\246\350\274\224\345\212\251\346\212\221\345\210\266\345\271\275\351\226\200\350\236\272\346\227\213\346\241\277\350\217\214\345\205\267\346\234\211\347\247\221\345\255\270\346\224\257\346\214\201\343\200\202\n                  </p>\n                </div>\n\n                {/* All-round Cooking Advantages */}\n                <div className=\"p-4 rounded-xl bg-emerald-50/70 border border-emerald-200/80 space-y-2 text-xs sm:text-sm text-stone-800\">\n                  <div className=\"flex items-center gap-2 text-emerald-900 font-bold\">\n                    <Flame className=\"w-4 h-4 text-emerald-700 shr